---
// Datenschutzerklärung unter der bestehenden Adresse /datenschutz.html (die App verlinkt sie). Der Wortlaut kommt
// unverändert aus dem Baustein src/inhalte/datenschutz.html (tools/rechtstexte_uebernehmen.mjs); hier entsteht nur
// die Gestaltung (src/components/Rechtsseite.astro): Die Überschrift und die Zeile mit Version und Stand stehen im
// Kopf, die Abschnitte im Inhaltsverzeichnis an der Seite.
import Rechtsseite from '../components/Rechtsseite.astro';
import erklaerung from '../inhalte/datenschutz.html?raw';
import { geruest } from '../daten/startseite.mjs';

const anfang = erklaerung.match(/^\s*<h1>([^<]*)<\/h1>\s*<p>([^<]*)<\/p>\s*/);
if (!anfang) throw new Error('Datenschutzerklärung: Überschrift und Zeile mit Version und Stand am Anfang erwartet.');
const [ganz, ueberschrift, stand] = anfang;
const rumpf = erklaerung.slice(ganz.length);
const abschnitte = [...erklaerung.matchAll(/<h2 id="([^"]+)">([^<]*)<\/h2>/g)].map(([, kennung, text]) => ({ kennung, text, teil: kennung.startsWith('teil-') }));
---
<Rechtsseite adresse="/datenschutz.html" krumen={[{ titel: geruest.recht.datenschutz, ziel: '/datenschutz.html' }]} titel={ueberschrift} stand={stand} inhalt={abschnitte}>
  <div class="text" set:html={rumpf} />
</Rechtsseite>
