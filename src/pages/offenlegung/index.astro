---
// Offenlegung nach § 25 Mediengesetz als eigene, schlichte Seite (AP-17 Teil E1): nicht im Index der Suchmaschinen
// und nicht in der Sitemap. Der Wortlaut kommt unverändert aus dem Baustein src/inhalte/offenlegung.html
// (tools/rechtstexte_uebernehmen.mjs); hier entsteht nur die Gestaltung. Die Überschrift des Bausteins wird zur
// Überschrift der Seite.
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import offenlegung from '../../inhalte/offenlegung.html?raw';
import { seite } from '../../daten/seite.mjs';
import { geruest } from '../../daten/startseite.mjs';

const texte = geruest.offenlegung;
const ueberschrift = offenlegung.match(/<h2[^>]*>([^<]*)<\/h2>/)?.[1] ?? texte.titel;
const rumpf = offenlegung.replace(/<h2[^>]*>[^<]*<\/h2>\s*/, '');
---
<Basis titel={`${ueberschrift} | ${seite.name}`} beschreibung={texte.beschreibung} index={false}>
  <Seitenkopf krumen={[{ titel: texte.titel, ziel: '/offenlegung/' }]} titel={ueberschrift} still />
  <div class="s-inhalt innen">
    <div class="text schmal" set:html={rumpf} />
  </div>
</Basis>
