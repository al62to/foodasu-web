---
// Eigene 404-Seite (AP-16 Nachtrag Website, Punkt 2; Aufbau seit AP-23 nach Entwurf "Zentriert, die Null als
// Zitronenscheibe"): Der Bau erzeugt 404.html, GitHub Pages liefert sie bei unbekannten Adressen mit Status 404 aus.
// Nicht in der Sitemap und mit noindex (src/daten/meta.mjs). Wortlaut in src/daten/startseite.mjs.
import Basis from '../layouts/Basis.astro';
import Motive from '../components/Motive.astro';
import '../styles/nichtgefunden.css';
import { geruest } from '../daten/startseite.mjs';
import { ziel } from '../daten/rezeptseiten.mjs';

const texte = geruest.nichtGefunden;
// Keine toten Links: Ein Chip erscheint nur, wenn es seine Themenseite gibt.
const themen = texte.themen.filter((thema) => ziel(thema.ziel));
// Die Zahl steht als "4", Zitronenscheibe, "4" da: Die Scheibe ersetzt die mittlere Ziffer.
const [vorn, hinten] = [texte.zahl.at(0), texte.zahl.at(-1)];
---
<Basis adresse="/404.html">
  <section class="nf muster">
    <Motive liste={[
      { art: 'aehre', breite: 110, lage: 'top: 40px; left: 8%', nurBreit: true },
      { art: 'blatt', breite: 150, lage: 'bottom: 30px; right: 7%', nurBreit: true },
    ]} />
    <div class="innen">
      <div class="nf-spalte">
        <p class="ueberzeile">{texte.etikett}</p>
        <div class="nf-zahl" aria-hidden="true">
          {vorn}
          <svg viewBox="0 0 100 100" focusable="false">
            <path class="nf-kerne" d="M85 50a35 35 0 1 1-70 0 35 35 0 0 1 70 0zM50 15v70M15 50h70M25.3 25.3l49.4 49.4M74.7 25.3L25.3 74.7" />
            <circle class="nf-schale" cx="50" cy="50" r="44" />
          </svg>
          {hinten}
        </div>
        <h1>{texte.titel[0]}<em>{texte.titel[1]}</em></h1>
        <p class="nf-text">{texte.text}</p>

        <div class="nf-knoepfe">
          <a class="knopf voll" href="/">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 11l9-7 9 7M5 10v10h14V10" /></svg>
            {texte.start}
          </a>
          <a class="knopf rand" href="/rezepte/">
            {texte.rezepte}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>

        {themen.length > 0 && (
          <div class="nf-themen">
            <h2>{texte.themenTitel}</h2>
            <ul class="chips">{themen.map((thema) => <li><a class="chip" href={thema.ziel}>{thema.titel}</a></li>)}</ul>
          </div>
        )}

        <div class="nf-karte blatt-karte">
          <div>
            <h2>{texte.karte.titel}</h2>
            <p>{texte.karte.text}</p>
          </div>
          <a class="knopf hell" href={texte.karte.ziel}>
            {texte.karte.knopf}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Basis>
