---
// Startseite unter dem Fokus-Keyword "Einkaufslisten App" (Auftrag SEO 1 neu der Projektleitung vom 14.10.2026) nach
// dem von Ali am 14.10.2026 freigegebenen Entwurf (foodasu-play/seo/entwurf_startseite). Gebaut mit den Bausteinen,
// Klassen und Farben der Website; alle Texte stehen in src/daten/startseite.mjs. Die Bewegung kommt aus
// src/styles/start.css (läuft ohne Skript) und aus src/skripte/bewegung.js (GSAP, wird erst nach dem ersten Zeichnen
// geladen). Ohne JavaScript und mit "Bewegung reduzieren" steht alles sofort und vollständig da.
// Reihenfolge: Kopf, "Einkaufen ohne", Einkaufswoche (#schritte), Video und "Mehr als ein Einkaufszettel",
// Vergleich, "FoodAsu im Bild", Zahlen, Rezepte, Fragen, Abschluss; dazu am Handy die Leiste unten.
import Basis from '../layouts/Basis.astro';
import Handy from '../components/Handy.astro';
import Logo from '../components/Logo.astro';
import Motive from '../components/Motive.astro';
import Unterschrift from '../components/Unterschrift.astro';
import '../styles/start.css';
import { seite, auftritte, store } from '../daten/seite.mjs';
import {
  kopf, wort, schritte, video, funktionen, vergleich, einblick, zahlen, vorschau, fragenStart, abschluss, kurzleiste,
  geruest,
} from '../daten/startseite.mjs';
import { fotoDaten } from '../daten/sogehts.mjs';
import { ziel, alteRezepte, websiteZahlen, texte as rezeptTexte } from '../daten/rezeptseiten.mjs';
import { jahreVonBis } from '../daten/alte_rezepte.mjs';
import { appDaten, entwicklerDaten, seitenDaten, ORGANISATION_ID, WEBSITE_ID } from '../daten/strukturiert.mjs';

const organisation = ORGANISATION_ID;
// Strukturierte Daten (Auftrag Teil 3 Nr. 1): WebSite und Organization wie bisher, dazu Person (Ali Tonc als
// Entwickler, nur Name und Website), seit AP-34 MobileApplication statt SoftwareApplication (eine Unterart; ohne
// offers, ohne Preis, ohne Bewertung wegen der Wortregel, auch wenn Google dann kein Rich Result zeigt; installUrl
// mit store.oeffentlich) und FAQPage, wortgleich zu den sichtbaren Fragen. Seit AP-35A (23.10.2026) kommen
// MobileApplication (mit fester Kennung /#app) und Person aus src/daten/strukturiert.mjs, dazu die Seite als WebPage
// mit Verweis auf die App.
const gleich = [auftritte.facebook, auftritte.instagram, store.oeffentlich ? store.adresse : ''].filter(Boolean);
const antwortText = (eintrag) => eintrag.antwort.join(' ');
const daten = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': WEBSITE_ID,
    name: seite.name,
    url: `${seite.adresse}/`,
    description: seite.beschreibung,
    inLanguage: seite.sprache,
    publisher: { '@id': organisation },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organisation,
    name: seite.name,
    url: `${seite.adresse}/`,
    description: seite.beschreibung,
    logo: seite.adresse + seite.logo,
    sameAs: gleich,
  },
  seitenDaten('/'),
  entwicklerDaten(),
  appDaten(),
  // Video der Startseite (Stufe 2, Projektleitung, 14.10.2026, 13:45): ohne Preis und ohne Bewertung; Poster und
  // Film im Format für den Laptop. Google zeigt ein Video meist nur als Video-Ergebnis, wenn es der Hauptinhalt einer
  // Seite ist; hier dient die Angabe vor allem der maschinellen Lesbarkeit.
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    '@id': `${seite.adresse}/#video`,
    name: video.name,
    description: video.beschreibung,
    thumbnailUrl: [`${seite.adresse}/bilder/start/${video.datei}-laptop-720.webp`],
    contentUrl: `${seite.adresse}/bilder/start/${video.datei}-laptop.mp4`,
    duration: video.dauer,
    uploadDate: video.hochgeladen,
    inLanguage: seite.sprache,
    publisher: { '@id': organisation },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${seite.adresse}/#fragen`,
    mainEntity: fragenStart.liste.map((eintrag) => ({
      '@type': 'Question',
      name: eintrag.frage,
      acceptedAnswer: { '@type': 'Answer', text: antwortText(eintrag) },
    })),
  },
];

// Karte zur Rubrik "Aus alten Kochbüchern" (AP-25): das Rezept, das src/daten/startseite.mjs nennt, sonst das erste.
const altBild = alteRezepte.find((rezept) => rezept.slug === vorschau.alt.bild) ?? alteRezepte[0];
const [altVon, altBis] = alteRezepte.length ? jahreVonBis() : [];
const quellen = (datei, endung) => [360, 720].map((breite) => `/bilder/rezepte/${datei}-${breite}.${endung} ${breite}w`).join(', ');
const linien = { fill: 'none', stroke: 'currentColor', 'stroke-width': '2', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' };
const urteilZeichen = 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM9 9l6 6M15 9l-6 6';
// Zeichen der sechs Funktionen ("symbol" in den Daten), dieselben wie bisher.
const funktionZeichen = {
  scan: 'M4 7V5a1 1 0 0 1 1-1h2M17 4h2a1 1 0 0 1 1 1v2M20 17v2a1 1 0 0 1-1 1h-2M7 20H5a1 1 0 0 1-1-1v-2M8 8v8M11 8v8M14 8v8M16.5 8v8',
  haushalt: 'M9 11.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zM3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M17 11.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM15.5 14.2c3 .2 5.5 2.7 5.5 5.8',
  liste: 'M6 3h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM8 9l1.5 1.5L12 8M14 9.5h3M8 15h9',
  buch: 'M4 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H4zM20 4h-4a2 2 0 0 0-2 2M20 4v14h-6',
  topf: 'M4 11h16v3a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6zM2 11h20M9 7c0-1.5 1-1.5 1-3M14 7c0-1.5 1-1.5 1-3',
  handy: 'M9 2h6a3 3 0 0 1 3 3v14a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3zM10 10h4a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1zM10 10V8.5a2 2 0 0 1 4 0V10',
};
for (const karte of funktionen.karten) {
  if (!funktionZeichen[karte.symbol]) throw new Error(`Startseite: Zeichen „${karte.symbol}“ der Funktion „${karte.titel}“ fehlt.`);
}
if (funktionen.karten.length !== 6) throw new Error('Startseite: Alle sechs Funktionen bleiben drin (Auftrag Teil 1 Nr. 7).');
if (schritte.liste.length !== 3) throw new Error('Startseite: Die Einkaufswoche hat drei Schritte (Auftrag Teil 1 Nr. 5).');
if (fragenStart.liste.length !== 7) throw new Error('Startseite: sieben Fragen erwartet (Auftrag Teil 2 Nr. 9).');
const pfeilRechts = 'M5 12h14M13 6l6 6-6 6';
// Zahlen im Zahlenblock mit Tausenderpunkt (ab 0.15: Einträge zum Meiden über tausend).
const tausender = new Intl.NumberFormat('de-DE');
// Poster des Videos: am Handy das Bild im Format der kleinen Bühne, ab 56rem das der großen (wie start.css), je in
// 360 und 720 Pixel Breite. Die Bühne hat ein festes Seitenverhältnis, das Poster füllt sie.
const filmOrt = `/bilder/start/${video.datei}`;
const posterQuellen = (format) => [360, 720].map((breite) => `${filmOrt}-${format}-${breite}.webp ${breite}w`).join(', ');
---
<Basis daten={daten}>
  <button type="button" class="bewegung-knopf" data-bewegung data-anhalten={geruest.bewegung.anhalten} data-fortsetzen={geruest.bewegung.fortsetzen} hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="z-halt" d="M8 5v14M16 5v14" /><path class="z-lauf" d="M8 5l11 7-11 7z" /></svg>
    <span data-bewegung-text>{geruest.bewegung.anhalten}</span>
  </button>

  <section class="held muster" id="start">
    <Motive liste={[
      { art: 'zitrone', breite: 200, klasse: 'm-held' },
      { art: 'blatt', breite: 150, lage: 'bottom: -30px; left: 8%', nurBreit: true },
    ]} />
    <div class="innen held-raster">
      <div class="held-text">
        <h1 class="held-titel"><span class="h-gross">{kopf.ueberschrift[0]}</span>{' '}<span class="h-gross h-farbe">{kopf.ueberschrift[1]}</span>{' '}<span class="h-klein">{kopf.ueberschrift[2]}</span></h1>
        <p class="held-satz">{kopf.satz.vor}<em>{kopf.satz.betont}</em>{kopf.satz.nach}</p>
        <div class="held-knoepfe">
          <a class="bald" href={store.adresse} rel="noopener"><i aria-hidden="true"></i><span>{kopf.aufruf}</span></a>
          <a class="knopf voll" href="#schritte">
            {kopf.zweiterKnopf}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...linien} stroke-width="2.4"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
          </a>
        </div>
        <p class="held-stand">{kopf.stand}</p>
      </div>
      <div class="buehne">
        {kopf.begriffe.map((begriff) => (
          <span class={`chip ruht schwebt s${begriff.platz}`} aria-hidden="true"><i></i>{begriff.wort}</span>
        ))}
        <div class="handy-rahmen">
          <div class="handy" role="img" aria-label={kopf.handy.beschreibung} data-handy>
            <div class="schirm" aria-hidden="true">
              <div class="kamera">
                <div class="strichcode"><i></i></div>
              </div>
              <div class="blatt" data-blatt>
                <div class="griff"></div>
                <div class="produkt">{kopf.handy.produkt}</div>
                <div class="zusatz">{kopf.handy.zusatz}</div>
                <div class="urteil-rot" data-urteil>
                  <svg viewBox="0 0 24 24" {...linien}><path d={urteilZeichen} /></svg>
                  {kopf.handy.urteil}
                </div>
                {kopf.handy.personen.map((person, nummer) => (
                  <div class="person" data-person>
                    <span><span class="kuerzel">{person.name[0]}</span>{person.name}</span>
                    <span class:list={['pille', nummer === 0 ? 'r' : 'n']}>{person.ergebnis}</span>
                  </div>
                ))}
                <div class="leiste"><div class="dazu">{kopf.handy.knopf}</div></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wort" id="ohne">
    <div class="innen wort-raster">
      <div>
        <h2 class="gross">
          <span class="gross-vor">{wort.vorsatz}</span>
          <span class="rot" aria-hidden="true"><span data-wort data-woerter={JSON.stringify(wort.woerter)}>{wort.woerter[0]}</span></span>
          <span class="vh">{wort.woerter.join(', ')}</span>
        </h2>
        <ul class="chips wort-marken" aria-hidden="true">
          {wort.woerter.map((eintrag, nummer) => <li class:list={['chip', 'ruht', { an: nummer === 0 }]} data-wortmarke>{eintrag}</li>)}
        </ul>
      </div>
      <div class="wort-text">
        {wort.absaetze.map((absatz) => <p>{absatz}</p>)}
        <Unterschrift text={wort.unterschrift} />
        <p class="wort-link">
          <a class="pfeil-link" href={wort.link.ziel}>
            {wort.link.text}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...linien} stroke-width="2.2"><path d={pfeilRechts} /></svg>
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="schritte" id="schritte">
    <div class="innen">
      <h2 class="titel mittig">{schritte.ueberschrift}</h2>
      <p class="unterzeile">{schritte.unterzeile}</p>
      <div class="weg">
        <Motive liste={[{ art: 'zitrone', breite: 150, lage: 'top: -40px; right: -30px', nurBreit: true }]} />
        <span class="weg-linie" aria-hidden="true"><i data-linie="schritte"></i></span>
        <ol class="schritt-liste">
          {schritte.liste.map((schritt, nummer) => (
            <li class="schritt">
              <div class="schritt-karte">
                <span class="schritt-nr" aria-hidden="true">{nummer + 1}</span>
                <h3>{schritt.titel}</h3>
                <p>{schritt.text}</p>
                <p class="mehr-link">
                  <a href={schritt.ziel}>
                    <span class="mehr-wort">{schritte.mehr}</span><span class="vh"> {schritt.ort}</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...linien} stroke-width="2.2"><path d={pfeilRechts} /></svg>
                  </a>
                </p>
              </div>
              <div class="schritt-bild">
                <Handy foto={fotoDaten({ datei: schritt.bild, alt: schritt.alt })} groessen="(min-width: 56rem) 12.5rem, 8rem" schnitt={false} />
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="knoepfe mittig"><a class="knopf rand" href={schritte.link.ziel}>{schritte.link.text}</a></div>
    </div>
  </section>

  <section class="mehr" id="funktionen">
    <div class="innen mehr-raster">
      <figure class="video-feld muster" data-video>
        <div class="video-buehne">
          <picture>
            <source media="(min-width: 56rem)" srcset={posterQuellen('laptop')} sizes="31rem" width={video.formate.laptop.breite} height={video.formate.laptop.hoehe} />
            <img
              src={`${filmOrt}-handy-720.webp`}
              srcset={posterQuellen('handy')}
              sizes="calc(100vw - 3.7rem)"
              alt={video.beschreibung}
              width={video.formate.handy.breite}
              height={video.formate.handy.hoehe}
              loading="lazy"
              decoding="async"
              data-film={filmOrt}
            />
          </picture>
        </div>
      </figure>
      <div class="mehr-text">
        <h2 class="titel">{funktionen.ueberschrift}</h2>
        <ul class="funktion-liste">
          {funktionen.karten.map((karte, nummer) => (
            <li>
              <details class="funktion" open={nummer === 0}>
                <summary>
                  <span class="funktion-zeichen" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false" {...linien}><path d={funktionZeichen[karte.symbol]} /></svg></span>
                  <span class="funktion-kopf">
                    <h3>{karte.titel}</h3>
                    <span class="funktion-kurz">{karte.kurz}</span>
                  </span>
                </summary>
                <div class="funktion-text">{karte.text.map((absatz) => <p>{absatz}</p>)}</div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="vergleich" id="vergleich">
    <div class="innen vergleich-raster">
      <h2 class="titel" id="vergleich-titel">{vergleich.ueberschrift}</h2>
      <table class="vergleich-tabelle" aria-labelledby="vergleich-titel">
        <thead>
          <tr>{vergleich.spalten.map((spalte, nummer) => <th scope="col" class:list={{ fa: nummer === 2 }}>{spalte}</th>)}</tr>
        </thead>
        <tbody>
          {vergleich.zeilen.map(([bedarf, liste, foodasu]) => (
            <tr>
              <th scope="row">{bedarf}</th>
              <td class:list={{ ja: liste === 'ja' }}>{liste}</td>
              <td class:list={{ ja: foodasu === 'ja' }}>{foodasu}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="vergleich-satz">{vergleich.satz}</p>
    </div>
  </section>

  <section class="einblick" id="einblick">
    <div class="innen">
      <h2 class="titel">{einblick.ueberschrift}</h2>
      <p class="einblick-text">{einblick.text}</p>
      <div class="einblick-flaeche">
        <Motive liste={[{ art: 'zitrone', breite: 150, lage: 'top: -60px; right: -40px' }]} />
        <span class="einblick-linie" aria-hidden="true"><i data-linie="einblick"></i></span>
        <ul class="einblick-karten">
          {einblick.karten.map((karte) => (
            <li class="einblick-karte">
              <Handy foto={fotoDaten({ datei: karte.datei, alt: karte.alt })} groessen="(min-width: 64rem) 10rem, (min-width: 40rem) 13rem, 8rem" />
              <div class="einblick-wort">
                <h3>{karte.titel}</h3>
                <p>{karte.text}</p>
                <p class="mehr-link">
                  <a href={karte.ziel}>
                    <span class="mehr-wort">{einblick.mehr}</span><span class="vh"> zu „{karte.titel}“</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...linien} stroke-width="2.2"><path d={pfeilRechts} /></svg>
                  </a>
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <p class="einblick-hinweis">{einblick.hinweis}</p>
      <div class="knoepfe"><a class="knopf rand" href={einblick.ziel}>{einblick.link}</a></div>
    </div>
  </section>

  <section class="zahlen muster" id="zahlen">
    <div class="innen">
      <h2 class="vh">{zahlen.ueberschrift}</h2>
      <ul class="zaehler">
        {zahlen.zaehler.map((eintrag) => (
          <li>
            <span class="vh">{tausender.format(eintrag.zahl)}</span>
            <b aria-hidden="true" data-zahl={eintrag.zahl}>{tausender.format(eintrag.zahl)}</b>
            <span class="wortlaut">{eintrag.wort}</span>
          </li>
        ))}
      </ul>
      <ul class="chips band-liste">
        {zahlen.zutatenband.map((eintrag) => <li class="chip ruht">{eintrag}</li>)}
      </ul>
      <ul class="chips band-liste">
        {zahlen.rezeptband.map((eintrag) => <li class="chip ruht">{eintrag}</li>)}
      </ul>
    </div>
  </section>

  <section class="vorschau" id="rezepte">
    <div class="innen">
      <h2 class="titel">{vorschau.ueberschrift}</h2>
      <p class="vorschau-text">{vorschau.text}</p>
      <ul class="rezeptkarten">
        {vorschau.karten.map((rezept) => {
          const adresse = ziel(`/rezepte/${rezept.datei}/`);
          return (
            <li class="rezeptkarte">
              <div class="rezeptbild">
                <picture>
                  <source type="image/avif" srcset={quellen(rezept.datei, 'avif')} sizes="(min-width: 56rem) 17rem, 44vw" />
                  <source type="image/webp" srcset={quellen(rezept.datei, 'webp')} sizes="(min-width: 56rem) 17rem, 44vw" />
                  <img src={`/bilder/rezepte/${rezept.datei}-720.webp`} alt={`${vorschau.kennzeichnung}: ${rezept.titel}`} width="720" height="540" loading="lazy" decoding="async" />
                </picture>
                <span class="symbolbild" aria-hidden="true">{vorschau.kennzeichnung}</span>
              </div>
              <h3>{adresse ? <a href={adresse}>{rezept.titel}</a> : rezept.titel}</h3>
            </li>
          );
        })}
      </ul>
      {alteRezepte.length > 0 && (
        <div class="alt-karte">
          <div class="rezeptbild">
            <picture>
              <source type="image/avif" srcset={`/bilder/rezepte/${altBild.slug}-karte-360.avif 360w, /bilder/rezepte/${altBild.slug}-karte-720.avif 720w`} sizes="(min-width: 56rem) 17rem, 88vw" />
              <img src={`/bilder/rezepte/${altBild.slug}-karte-720.webp`} srcset={`/bilder/rezepte/${altBild.slug}-karte-360.webp 360w, /bilder/rezepte/${altBild.slug}-karte-720.webp 720w`} sizes="(min-width: 56rem) 17rem, 88vw" alt={`${rezeptTexte.symbolbild}: ${altBild.titel}`} width="720" height="540" loading="lazy" decoding="async" />
            </picture>
            <span class="symbolbild" aria-hidden="true">{vorschau.kennzeichnung}</span>
          </div>
          <div class="alt-karte-text">
            <h3><a href={vorschau.alt.ziel}>{vorschau.alt.titel}</a></h3>
            <p>{vorschau.alt.text(alteRezepte.length, altVon, altBis)}</p>
            <p class="alt-karte-link" aria-hidden="true">{vorschau.alt.link}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...linien}><path d="M5 12h14M13 6l6 6-6 6" /></svg></p>
          </div>
        </div>
      )}
      {vorschau.hinweis(websiteZahlen).map((satz) => <p class="vorschau-hinweis">{satz}</p>)}
      <div class="knoepfe"><a class="knopf rand" href="/rezepte/">{vorschau.link(websiteZahlen)}</a></div>
    </div>
  </section>

  <section class="faq" id="fragen">
    <div class="innen schmal">
      <h2 class="titel mittig">{fragenStart.ueberschrift}</h2>
      {fragenStart.liste.map((eintrag) => (
        <details>
          <summary>{eintrag.frage}</summary>
          <div>
            {eintrag.antwort.map((absatz) => <p>{absatz}</p>)}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="abschluss" id="abschluss">
    <div class="innen">
      <div class="abschluss-karte muster">
        <div class="abschluss-text">
          <h2>{abschluss.ueberschrift}</h2>
          <p>{abschluss.satz}</p>
        </div>
        <a class="bald" href={store.adresse} rel="noopener"><i aria-hidden="true"></i><span>{abschluss.knopf}</span></a>
        <p class="abschluss-beta">{abschluss.beta}</p>
      </div>
    </div>
  </section>

  <aside class="kurzleiste" aria-label={kurzleiste.name} data-kurzleiste hidden>
    <a class="kurzleiste-marke" href="#start" aria-label={kurzleiste.logo}><Logo /></a>
    <a class="knopf voll kurzleiste-knopf" href={store.oeffentlich ? store.adresse : kurzleiste.ziel}><i aria-hidden="true"></i><span>{store.oeffentlich ? kurzleiste.storeKnopf : kurzleiste.knopf}</span></a>
  </aside>
</Basis>

<script>
  // Ohne "Bewegung reduzieren": GSAP nachladen, erst nach dem ersten Zeichnen. Mit "Bewegung reduzieren" wird GSAP gar
  // nicht geladen. Der Knopf "Bewegung anhalten" erscheint, sobald Bewegung läuft. Sein Zustand steht nur in einer
  // Variablen dieser Seite: Er gilt für den Besuch, im Browser wird nichts gespeichert.
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');
  const knopf = document.querySelector('[data-bewegung]');
  const wurzel = document.documentElement;
  let geladen = false;
  let angehalten = false;
  let bewegung;

  const starte = () => {
    if (geladen || ruhig.matches) return;
    geladen = true;
    knopf.hidden = false;
    import('../skripte/bewegung.js').then((modul) => {
      bewegung = modul;
      if (!angehalten) modul.starte();
    });
  };
  knopf.addEventListener('click', () => {
    angehalten = !angehalten;
    wurzel.classList.toggle('angehalten', angehalten);
    knopf.querySelector('[data-bewegung-text]').textContent = angehalten ? knopf.dataset.fortsetzen : knopf.dataset.anhalten;
    if (bewegung) angehalten ? bewegung.halte() : bewegung.starte();
  });
  // "Nach dem ersten Zeichnen" heißt: Der Browser hat das erste Bild der Seite gemeldet (first-contentful-paint)
  // und die Seite ist fertig geladen. Kennt ein Browser die Meldung nicht, zählt der Zeitgeber.
  const gezeichnet = new Promise((weiter) => {
    const gemeldet = () => performance.getEntriesByName('first-contentful-paint').length > 0;
    if (gemeldet()) return weiter();
    try {
      const beobachter = new PerformanceObserver(() => {
        if (!gemeldet()) return;
        beobachter.disconnect();
        weiter();
      });
      beobachter.observe({ type: 'paint', buffered: true });
    } catch {
      // ohne diese Schnittstelle bleibt der Zeitgeber
    }
    setTimeout(weiter, 4000);
  });
  const fertig = new Promise((weiter) => {
    if (document.readyState === 'complete') weiter();
    else window.addEventListener('load', weiter, { once: true });
  });
  Promise.all([gezeichnet, fertig]).then(() => setTimeout(starte, 150));
  ruhig.addEventListener('change', () => {
    starte();
    knopf.hidden = ruhig.matches || !geladen;
  });

  // Leiste unten am Handy: erscheint, sobald der erste Bildschirm durchgescrollt ist, und nur unter 56rem Breite
  // (darüber blendet sie start.css aus). Sie ist ein eigener Bereich mit zwei Links; am Seitenende hält start.css
  // Platz für sie frei.
  const leiste = document.querySelector('[data-kurzleiste]');
  const schmal = window.matchMedia('(max-width: 55.99rem)');
  const leisteZeigen = () => {
    const zeigen = schmal.matches && window.scrollY > window.innerHeight * 0.9;
    if (leiste.hidden === zeigen) leiste.hidden = !zeigen;
  };
  window.addEventListener('scroll', leisteZeigen, { passive: true });
  schmal.addEventListener('change', leisteZeigen);
  leisteZeigen();

  // Video (Auftrag Teil 1 Nr. 6; Stufe 2 vom 14.10.2026): Bis zum Scrollen steht nur das Poster da ("data-film" am
  // Poster nennt den Ort der Dateien). Kommt es in die Nähe des Fensters, lädt das Video im Format der Bühne (Handy
  // unter 56rem, Laptop ab 56rem; WebM, sonst MP4), ersetzt das Poster, sobald es spielen kann, und läuft ohne Ton in
  // Schleife, nur ohne "Bewegung reduzieren". Dann bleibt das Poster stehen. Der Knopf "Bewegung anhalten" hält das
  // Video an und lässt es weiterlaufen; außerhalb des Fensters steht es ebenfalls. Wie die Schleifen der Anleitung.
  const standbild = document.querySelector('[data-video] img[data-film]');
  if (standbild && 'IntersectionObserver' in window) {
    const breit = window.matchMedia('(min-width: 56rem)');
    let film;
    let zuSehen = true;
    const folge = () => {
      if (!film) return;
      if (zuSehen && !wurzel.classList.contains('angehalten') && !ruhig.matches) film.play().catch(() => {});
      else film.pause();
    };
    // Quellen des Videos für die aktuelle Breite; wechselt die Breite über 56rem, lädt das andere Format.
    const quellen = (ziel) => {
      const format = breit.matches ? 'laptop' : 'handy';
      if (ziel.dataset.format === format) return;
      ziel.dataset.format = format;
      ziel.replaceChildren(...[['webm', 'video/webm'], ['mp4', 'video/mp4']].map(([endung, art]) => {
        const quelle = document.createElement('source');
        quelle.src = `${standbild.dataset.film}-${format}.${endung}`;
        quelle.type = art;
        return quelle;
      }));
      ziel.load();
    };
    const beobachter = new IntersectionObserver((eintraege) => {
      if (!eintraege.some((eintrag) => eintrag.isIntersecting) || ruhig.matches) return;
      beobachter.disconnect();
      const neu = document.createElement('video');
      neu.muted = true;
      neu.defaultMuted = true;
      neu.loop = true;
      neu.playsInline = true;
      neu.preload = 'auto';
      neu.setAttribute('muted', '');
      neu.setAttribute('playsinline', '');
      neu.setAttribute('aria-label', standbild.alt);
      neu.poster = standbild.currentSrc || standbild.src;
      quellen(neu);
      neu.addEventListener('canplay', () => {
        (standbild.closest('picture') ?? standbild).replaceWith(neu);
        film = neu;
        new IntersectionObserver((stand) => { zuSehen = stand.at(-1).isIntersecting; folge(); }).observe(neu);
        folge();
        breit.addEventListener('change', () => { quellen(neu); folge(); });
      }, { once: true });
      new MutationObserver(folge).observe(wurzel, { attributes: true, attributeFilter: ['class'] });
      ruhig.addEventListener('change', folge);
    }, { rootMargin: '200px' });
    beobachter.observe(standbild);
  }
</script>
