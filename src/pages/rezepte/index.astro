---
// Übersicht "Rezepte" (AP-17 Teil E3; Aufbau seit AP-23 nach Entwurf "Filter in der Seitenleiste"): Ab 64rem Breite
// stehen die vier Filtergruppen (Passt für, Kategorie, Land, Zeit) ständig offen in einer weißen Leiste links, die beim
// Scrollen mitfährt; rechts Suchfeld, Trefferzahl, die gewählten Filter als Chips und die Karten in drei Spalten. Am
// Handy und Tablet öffnet der Knopf "Filter" wie bisher ein Blatt von unten. Darunter alle Themenseiten als Chips.
// Gefiltert wird im Browser über Angaben an den Karten: keine neuen Adressen, nichts wird gespeichert oder geladen.
// Alle Karten stehen im HTML und sind ohne Auswahl sichtbar; ohne JavaScript entfallen Suche und Filter, und die
// Themenseiten übernehmen die Auswahl.
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Rezeptkarte from '../../components/Rezeptkarte.astro';
import '../../styles/rezepte.css';
import { alteSeite, zeitraeume } from '../../daten/alte_rezepte.mjs';
import { seite } from '../../daten/seite.mjs';
import {
  rezepte, alteRezepte, texte, KATEGORIE, LAND, LAND_REIHENFOLGE, EINTRAEGE, FILTER_PASST, FILTER_ZUERST,
  rezeptAdresse, ziel, filterAngaben, themenMitSeite, websiteZahlen,
} from '../../daten/rezeptseiten.mjs';

const t = texte.alle;
const nachName = [...rezepte].sort((a, b) => a.titel.localeCompare(b.titel, 'de'));
const angaben = rezepte.map(filterAngaben);
const anzahl = (probe) => angaben.filter(probe).length;
const eintragVon = new Map(EINTRAEGE.map((eintrag) => [eintrag.schluessel, eintrag]));

// Nur Möglichkeiten, zu denen es Rezepte gibt, jede mit ihrer Anzahl.
const kategorien = Object.keys(KATEGORIE)
  .map((schluessel) => ({ wert: schluessel, wort: KATEGORIE[schluessel][0], zahl: anzahl((a) => a.kategorie === schluessel) }));
const laender = LAND_REIHENFOLGE
  .map((kuerzel) => ({ wert: kuerzel, wort: LAND[kuerzel], zahl: anzahl((a) => a.land.split(' ').includes(kuerzel)) }));
const passt = FILTER_PASST
  .map((schluessel) => {
    const eintrag = eintragVon.get(schluessel);
    return { wert: schluessel, wort: eintrag.adresse ? t.ohne(eintrag.ohne) : eintrag.name, zahl: anzahl((a) => a.passt.split(' ').includes(schluessel)) };
  });
// "Zeit": die Zeiträume der Rezepte aus alten Kochbüchern. Der Wert an der Karte ist die Sprungmarke des Zeitraums;
// die Anzahl muss die des Zeitstrahls auf der Sammelseite sein.
const zeiten = zeitraeume.map((zeitraum) => ({ wert: zeitraum.anker, wort: zeitraum.kennung, zahl: anzahl((a) => a.zeit === zeitraum.anker) }));
{
  const falsch = zeitraeume.filter((zeitraum, nummer) => zeiten[nummer].zahl !== zeitraum.rezepte.length);
  if (falsch.length) throw new Error(`Filter "Zeit": Anzahl weicht vom Zeitstrahl ab: ${falsch.map((zeitraum) => zeitraum.kennung).join(', ')}`);
}
// In der Leiste am Laptop zeigt "Land" zuerst so viele Länder; die anderen Gruppen stehen dort ganz da.
const LEISTE_ZUERST = 8;
const gruppen = [
  { kennung: 'passt', titel: t.gruppen.passt, zusatz: t.passtZusatz, wahl: passt, mehr: t.weitere.passt, breitGanz: true },
  { kennung: 'kategorie', titel: t.gruppen.kategorie, wahl: kategorien },
  { kennung: 'land', titel: t.gruppen.land, wahl: laender, mehr: t.weitere.land },
  { kennung: 'zeit', titel: t.gruppen.zeit, zusatz: t.zeitZusatz, wahl: zeiten },
].filter((gruppe) => gruppe.wahl.length > 0).map((gruppe) => {
  const wahl = gruppe.wahl.filter((eintrag) => eintrag.zahl > 0);
  // Lange Listen zeigen zuerst nur den Anfang; der Rest folgt hinter "Weitere ... anzeigen". "spaeter" gilt im Blatt
  // am Handy und Tablet, "spaeterBreit" in der Leiste am Laptop.
  const vorn = gruppe.mehr && wahl.length > FILTER_ZUERST + 2 ? FILTER_ZUERST : wahl.length;
  const vornBreit = gruppe.breitGanz ? wahl.length : gruppe.mehr && wahl.length > LEISTE_ZUERST + 2 ? LEISTE_ZUERST : wahl.length;
  return {
    ...gruppe,
    wahl: wahl.map((eintrag, nummer) => ({ ...eintrag, spaeter: nummer >= vorn, spaeterBreit: nummer >= vornBreit })),
    geteilt: vorn < wahl.length,
    geteiltBreit: vornBreit < wahl.length,
  };
});
// Alle Themenseiten als Chips, eine Zeile je Gruppe; der Name eines Chips ist der des Eintrags im Menü.
const themenZeilen = ['ohne', 'passt', 'land', 'kategorie'].map((art) => ({
  art,
  titel: t.themenZeilen[art],
  zusatz: art === 'ohne' ? t.passtZusatz : null,
  themen: themenMitSeite
    .filter((thema) => thema.art === art && ziel(thema.adresse))
    .map((thema) => ({ name: art === 'ohne' ? t.ohne(thema.menue) : thema.menue, ziel: thema.adresse, titel: thema.titel }))
    .sort((a, b) => a.name.localeCompare(b.name, 'de')),
})).filter((zeile) => zeile.themen.length > 0);
// Dazu die Rubrik "Aus alten Kochbüchern" als eigene Zeile: keine Themenseite, sondern die Sammelseite.
if (alteRezepte.length > 0) themenZeilen.push({ art: 'zeit', titel: t.themenZeilen.zeit, zusatz: null, themen: [{ name: alteSeite.name, ziel: alteSeite.adresse, titel: alteSeite.name }] });
const text = t.text(websiteZahlen);
const daten = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.seitentitel,
  numberOfItems: nachName.length,
  itemListElement: nachName.map((rezept, nummer) => ({ '@type': 'ListItem', position: nummer + 1, url: seite.adresse + rezeptAdresse(rezept) })),
}];
---
<Basis daten={daten}>
  <Seitenkopf
    krumen={[{ titel: texte.uebersicht, ziel: '/rezepte/' }]}
    titel={t.seitentitel}
    vorspann={text}
    klein
    motive={[
      { art: 'aehre', breite: 120, lage: 'top: 10px; right: 120px', nurBreit: true },
      { art: 'zitrone', breite: 130, lage: 'bottom: -50px; right: 360px', ecke: true },
    ]}
  >
    <p class="klein">{t.grundlage}</p>
  </Seitenkopf>

  <div class="s-inhalt innen">
    <form class="f-seite" id="filter" role="search" aria-label={t.suche} data-filter>
      <div class="f-blatt" id="f-blatt" aria-labelledby="f-blatt-titel" data-blatt>
        <div class="f-blatt-kopf">
          <p id="f-blatt-titel">{t.filter}</p>
          <button type="button" class="f-schlicht f-alles" data-alle-leeren>{t.zuruecksetzen}</button>
          <button type="button" class="f-rund" aria-label={t.schliessen} data-blatt-zu>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
        </div>
        <div class="f-gruppen">
          {gruppen.map((gruppe) => (
            <div class:list={['f-gruppe', { 'breit-ganz': !gruppe.geteiltBreit }]} data-gruppe={gruppe.kennung}>
              <button type="button" class="f-knopf" aria-expanded="false" aria-controls={`f-${gruppe.kennung}`} data-knopf data-titel={gruppe.titel}>
                <span data-knopf-text>{gruppe.titel}</span>
                <svg class="pfeil" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg>
              </button>
              <div class="f-feld" id={`f-${gruppe.kennung}`} data-feld>
                <fieldset>
                  <legend>{gruppe.titel}{gruppe.zusatz && <><span class="vh">, </span><small>{gruppe.zusatz}</small></>}</legend>
                  <ul>
                    {gruppe.wahl.map((eintrag) => (
                      <li data-spaeter={eintrag.spaeter ? '' : undefined} data-spaeter-breit={eintrag.spaeterBreit ? '' : undefined}>
                        <label>
                          <input type="checkbox" name={gruppe.kennung} value={eintrag.wert} data-wort={eintrag.wort} />
                          <span>{eintrag.wort}</span>
                          <span class="f-anzahl">{eintrag.zahl}</span>
                        </label>
                      </li>
                    ))}
                  </ul>
                </fieldset>
                {gruppe.geteilt && <button type="button" class="f-schlicht" data-mehr>{gruppe.mehr}</button>}
                <div class="f-feld-fuss">
                  <button type="button" class="f-schlicht grau" data-leeren>{t.zuruecksetzen}</button>
                  <button type="button" class="f-voll" data-fertig>{t.fertig}</button>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="f-blatt-fuss">
          <button type="button" class="f-voll" data-blatt-zu data-zeigen data-eins={t.zeigen(1)} data-viele={t.zeigen(2).replace('2', '{zahl}')}>{t.zeigen(nachName.length)}</button>
        </div>
      </div>

      <div class="f-haupt">
        <div class="f-leiste">
          <label class="f-suche-titel" for="f-suche-feld">{t.suche}</label>
          <div class="f-suche">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <input type="search" id="f-suche-feld" name="suche" autocomplete="off" enterkeyhint="search" data-suche />
          </div>

          <div class="f-zeile">
            <button type="button" class="f-knopf f-mobil" aria-haspopup="dialog" aria-expanded="false" aria-controls="f-blatt" data-blatt-auf>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
              {t.filter}
              <span class="f-marke" data-aktiv-zahl hidden></span>
            </button>
            <p class="f-stand" role="status" data-stand data-eins={t.stand(1)} data-viele={t.stand(2).replace('2', '{zahl}')}>{t.stand(nachName.length)}</p>
          </div>

          <div class="f-aktiv" data-aktiv hidden>
            <ul class="f-aktiv-liste" aria-label={t.gewaehlt} data-aktiv-liste data-entfernen={t.entfernen('{wort}')}></ul>
            <button type="button" class="f-schlicht" data-alle-leeren>{t.alleZuruecksetzen}</button>
          </div>
        </div>

        <ul class="r-karten flach" data-karten>{nachName.map((rezept, nummer) => <Rezeptkarte rezept={rezept} vorn={nummer < 3} filter ein={false} />)}</ul>
        <div class="f-leer" data-leer hidden>
          <p>{t.leer}</p>
          <button type="button" class="chip" data-alle-leeren>{t.alleZuruecksetzen}</button>
        </div>
      </div>
    </form>
    <div class="f-schleier" data-schleier hidden></div>

    {themenZeilen.length > 0 && (
      <section class="f-themen" aria-labelledby="themen">
        <h2 id="themen">{t.themen}</h2>
        <dl>
          {themenZeilen.map((zeile) => (
            <div>
              <dt>{zeile.titel}{zeile.zusatz && <><span class="vh">, </span><small>{zeile.zusatz}</small></>}</dt>
              <dd><ul class="chips">{zeile.themen.map((thema) => <li><a class="chip" href={thema.ziel} aria-label={thema.titel}>{thema.name}</a></li>)}</ul></dd>
            </div>
          ))}
        </dl>
      </section>
    )}
  </div>
</Basis>

<script>
  // Suche und Filter ohne Server: Jede Karte trägt ihre Angaben als Attribute. Nichts wird gespeichert, nichts geladen.
  // Verknüpfung: innerhalb von Kategorie, von Land und von Zeit "oder", innerhalb von "Passt für" "und" (ohne Nüsse
  // und vegan heißt beides), zwischen den Gruppen "und". Einen Zeitraum tragen nur die Rezepte aus alten Kochbüchern.
  const form = document.querySelector('[data-filter]');
  if (form) {
    const karten = [...document.querySelectorAll('[data-karte]')];
    const suche = form.querySelector('[data-suche]');
    const stand = form.querySelector('[data-stand]');
    const leer = document.querySelector('[data-leer]');
    const blatt = form.querySelector('[data-blatt]');
    const blattAuf = form.querySelector('[data-blatt-auf]');
    const schleier = document.querySelector('[data-schleier]');
    const aktiv = form.querySelector('[data-aktiv]');
    const aktivListe = form.querySelector('[data-aktiv-liste]');
    const aktivZahl = form.querySelector('[data-aktiv-zahl]');
    const zeigen = form.querySelector('[data-zeigen]');
    const gruppen = [...form.querySelectorAll('[data-gruppe]')];
    // Bis 64rem (Handy und Tablet) liegen die Gruppen im Blatt; darüber stehen sie offen in der Leiste.
    const schmal = window.matchMedia('(max-width: 63.99rem)');
    const UND = new Set(['passt']);
    const kreuz = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>';

    const gewaehlt = (gruppe) => [...gruppe.querySelectorAll('input:checked')];
    const offen = (el) => el.getAttribute('aria-expanded') === 'true';
    const knopfVon = (gruppe) => gruppe.querySelector('[data-knopf]');

    const zeige = () => {
      const worte = suche.value.toLocaleLowerCase('de').split(/\s+/).filter(Boolean);
      const wahl = Object.fromEntries(gruppen.map((gruppe) => [gruppe.dataset.gruppe, gewaehlt(gruppe).map((feld) => feld.value)]));
      let zahl = 0;
      for (const karte of karten) {
        const passt =
          Object.entries(wahl).every(([art, werte]) => {
            if (werte.length === 0) return true;
            const hat = (karte.dataset[art] ?? '').split(' ');
            return UND.has(art) ? werte.every((wert) => hat.includes(wert)) : werte.some((wert) => hat.includes(wert));
          }) && worte.every((wort) => karte.dataset.text.includes(wort));
        karte.hidden = !passt;
        if (passt) zahl++;
      }
      const text = (el) => (zahl === 1 ? el.dataset.eins : el.dataset.viele.replace('{zahl}', String(zahl)));
      stand.textContent = text(stand);
      zeigen.textContent = text(zeigen);
      leer.hidden = zahl > 0;

      // Gewählte Filter als Kärtchen mit X, die Knöpfe nennen ihre Auswahl.
      aktivListe.replaceChildren();
      let alle = 0;
      for (const gruppe of gruppen) {
        const felder = gewaehlt(gruppe);
        alle += felder.length;
        const knopf = knopfVon(gruppe);
        const titel = knopf.dataset.titel;
        knopf.querySelector('[data-knopf-text]').textContent =
          felder.length === 0 ? titel : `${titel}: ${felder[0].dataset.wort}${felder.length > 1 ? ` +${felder.length - 1}` : ''}`;
        knopf.classList.toggle('gewaehlt', felder.length > 0);
        for (const feld of felder) {
          const punkt = document.createElement('li');
          const entfernen = document.createElement('button');
          entfernen.type = 'button';
          entfernen.className = 'f-karte';
          entfernen.setAttribute('aria-label', aktivListe.dataset.entfernen.replace('{wort}', feld.dataset.wort));
          entfernen.innerHTML = kreuz;
          entfernen.prepend(feld.dataset.wort);
          entfernen.addEventListener('click', () => {
            feld.checked = false;
            zeige();
            (aktivListe.querySelector('button') ?? knopf).focus();
          });
          punkt.append(entfernen);
          aktivListe.append(punkt);
        }
      }
      aktiv.hidden = alle === 0;
      aktivZahl.hidden = alle === 0;
      aktivZahl.textContent = String(alle);
    };

    // Auswahlknöpfe: am Handy und Tablet Abschnitte im Blatt. Am Laptop stehen alle Gruppen offen in der Leiste; die
    // Knöpfe sind dort nicht zu sehen.
    const schliesseFelder = (ausser) => {
      for (const gruppe of gruppen) if (gruppe !== ausser) knopfVon(gruppe).setAttribute('aria-expanded', 'false');
    };
    for (const gruppe of gruppen) {
      const knopf = knopfVon(gruppe);
      knopf.addEventListener('click', () => {
        const auf = !offen(knopf);
        if (!schmal.matches) schliesseFelder(gruppe);
        knopf.setAttribute('aria-expanded', String(auf));
      });
      gruppe.addEventListener('change', zeige);
      gruppe.querySelector('[data-leeren]').addEventListener('click', () => {
        for (const feld of gewaehlt(gruppe)) feld.checked = false;
        zeige();
      });
      gruppe.querySelector('[data-fertig]').addEventListener('click', () => {
        knopf.setAttribute('aria-expanded', 'false');
        knopf.focus();
      });
      const mehr = gruppe.querySelector('[data-mehr]');
      mehr?.addEventListener('click', () => {
        // Der Fokus geht auf die erste Möglichkeit, die neu dazukommt (im Blatt und in der Leiste verschieden viele).
        const erstes = gruppe.querySelector(schmal.matches ? '[data-spaeter] input' : '[data-spaeter-breit] input');
        gruppe.classList.add('ganz');
        mehr.hidden = true;
        erstes?.focus();
      });
    }

    // Blatt am Handy: ein Dialog von unten; der Fokus bleibt darin, Esc und der Schleier schließen.
    const setzeBlatt = (auf) => {
      blattAuf.setAttribute('aria-expanded', String(auf));
      document.documentElement.classList.toggle('blatt-offen', auf);
      schleier.hidden = !auf;
      if (auf) {
        blatt.setAttribute('role', 'dialog');
        blatt.setAttribute('aria-modal', 'true');
        if (!gruppen.some((gruppe) => offen(knopfVon(gruppe)))) knopfVon(gruppen[0]).setAttribute('aria-expanded', 'true');
        blatt.querySelector('[data-blatt-zu]').focus();
      } else {
        blatt.removeAttribute('role');
        blatt.removeAttribute('aria-modal');
        schliesseFelder(null);
      }
    };
    blattAuf.addEventListener('click', () => setzeBlatt(!offen(blattAuf)));
    for (const zu of form.querySelectorAll('[data-blatt-zu]')) {
      zu.addEventListener('click', () => {
        setzeBlatt(false);
        blattAuf.focus();
      });
    }
    schleier.addEventListener('click', () => setzeBlatt(false));
    blatt.addEventListener('keydown', (ereignis) => {
      if (ereignis.key !== 'Tab' || !offen(blattAuf)) return;
      const ziele = [...blatt.querySelectorAll('button, input')].filter((el) => el.offsetParent !== null);
      const erstes = ziele[0];
      const letztes = ziele.at(-1);
      if (ereignis.shiftKey && document.activeElement === erstes) {
        ereignis.preventDefault();
        letztes.focus();
      } else if (!ereignis.shiftKey && document.activeElement === letztes) {
        ereignis.preventDefault();
        erstes.focus();
      }
    });

    form.addEventListener('keydown', (ereignis) => {
      if (ereignis.key !== 'Escape') return;
      if (offen(blattAuf)) {
        setzeBlatt(false);
        blattAuf.focus();
        return;
      }
      const gruppe = gruppen.find((eine) => offen(knopfVon(eine)));
      if (gruppe) {
        knopfVon(gruppe).setAttribute('aria-expanded', 'false');
        knopfVon(gruppe).focus();
      }
    });
    schmal.addEventListener('change', () => {
      setzeBlatt(false);
    });

    suche.addEventListener('input', zeige);
    form.addEventListener('submit', (ereignis) => ereignis.preventDefault());
    for (const knopf of document.querySelectorAll('[data-alle-leeren]')) {
      knopf.addEventListener('click', () => {
        suche.value = '';
        for (const feld of form.querySelectorAll('input:checked')) feld.checked = false;
        zeige();
        suche.focus();
      });
    }
    // Ein Verweis auf "#filter" zeigt die Seite am Handy und Tablet mit geöffnetem Blatt; am Laptop steht die Leiste da.
    if (window.location.hash === '#filter' && schmal.matches) setzeBlatt(true);
    zeige();
  }
</script>
