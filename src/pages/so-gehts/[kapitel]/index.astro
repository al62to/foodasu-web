---
// "So geht's", ein Kapitel (AP-15 Teil B2, Karte C): kurze Abschnitte mit den Begriffen der App, ein bis drei
// Bildschirmfotos und, wo es hilft, eine kurze Schleife ohne Ton. Alle Texte kommen aus src/daten/sogehts.mjs.
// Die Schleife läuft nur mit Bewegung: Ohne JavaScript und mit "Bewegung reduzieren" steht ihr Standbild da, und der
// Knopf "Bewegung anhalten" im Kopfbereich hält auch sie an.
import Basis from '../../../layouts/Basis.astro';
import Seitenkopf from '../../../components/Seitenkopf.astro';
import '../../../styles/sogehts.css';
import { seite } from '../../../daten/seite.mjs';
import { BEREICH, adresse, kapitel, rahmen, uebersicht } from '../../../daten/sogehts.mjs';
import { metaVon } from '../../../daten/meta.mjs';

export function getStaticPaths() {
  return kapitel.map((eintrag) => ({ params: { kapitel: eintrag.slug }, props: { slug: eintrag.slug } }));
}

const { slug } = Astro.props;
const stelle = kapitel.findIndex((eintrag) => eintrag.slug === slug);
const eintrag = kapitel[stelle];
const davor = kapitel[stelle - 1];
const danach = kapitel[stelle + 1];
const pfad = adresse(eintrag);
const marke = (titel) => titel.toLowerCase().replace(/[„“?]/g, '').replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const ORDNER = '/bilder/sogehts/';
const BREITEN = [360, 720];
const bild = (name, breite) => `${ORDNER}${name}-${breite}.webp`;
const quellen = (name) => BREITEN.map((breite) => `${bild(name, breite)} ${breite}w`).join(', ');
const GROESSEN = '(min-width: 56rem) 16rem, 60vw';

// Gliederung für Suchmaschinen und KI-Antworten: das Kapitel als Artikel mit seinen Abschnitten. In den Daten steht
// nur, was auf der Seite sichtbar ist.
const daten = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: eintrag.titel,
  description: metaVon(pfad).beschreibung,
  inLanguage: 'de',
  mainEntityOfPage: seite.adresse + pfad,
  articleSection: eintrag.teile.map((teil) => teil.titel),
  isPartOf: { '@type': 'CollectionPage', name: uebersicht.titel, url: seite.adresse + BEREICH },
  publisher: { '@type': 'Organization', name: seite.name, url: seite.adresse },
}];
---
<Basis daten={daten}>
  <Seitenkopf
    krumen={[{ titel: uebersicht.titel, ziel: BEREICH }, { titel: eintrag.titel, ziel: pfad }]}
    etikett={`${uebersicht.kapitelWort} ${eintrag.nummer} von ${kapitel.length}`}
    titel={eintrag.titel}
    vorspann={eintrag.vorspann}
  />
  <div class="s-inhalt innen g-seite">
    <article class="g-text">
      <nav class="g-inhalt" aria-labelledby="g-inhalt-titel">
        <h2 id="g-inhalt-titel">{rahmen.inhalt}</h2>
        <ul>
          {eintrag.teile.map((teil) => <li><a href={`#${marke(teil.titel)}`}>{teil.titel}</a></li>)}
        </ul>
      </nav>
      {eintrag.teile.map((teil) => (
        <section class="s-teil" aria-labelledby={marke(teil.titel)}>
          <h2 id={marke(teil.titel)}>{teil.titel}</h2>
          {teil.einleitung && <p>{teil.einleitung}</p>}
          {teil.schritte && (
            <ol class="r-schritte">
              {teil.schritte.map((schritt) => <li>{schritt}</li>)}
            </ol>
          )}
          {teil.liste && (
            <dl class="r-stufen">
              {teil.liste.map((punkt) => <div><dt>{punkt.name}</dt><dd>{punkt.text}</dd></div>)}
            </dl>
          )}
          {(teil.absaetze ?? []).map((absatz) => <p>{absatz}</p>)}
          {teil.extern && <p><a href={teil.extern.ziel} rel="noopener">{teil.extern.text}</a></p>}
        </section>
      ))}
      {eintrag.verweise && (
        <div class="s-teil g-mehr">
          <h2>{rahmen.mehr}</h2>
          <ul class="chips">
            {eintrag.verweise.map((verweis) => <li><a class="chip" href={verweis.ziel}>{verweis.text}</a></li>)}
          </ul>
        </div>
      )}
    </article>

    <aside class="g-bilder" aria-label={rahmen.bilder}>
      {eintrag.film && (
        <figure class="g-handy" data-ein>
          <div class="g-rahmen">
            <img
              src={bild(`film-${eintrag.film.datei}`, 720)}
              srcset={quellen(`film-${eintrag.film.datei}`)}
              sizes={GROESSEN}
              alt={eintrag.film.alt}
              width="720"
              height="1620"
              decoding="async"
              data-film={`${ORDNER}film-${eintrag.film.datei}.webm`}
            />
          </div>
          <figcaption>{eintrag.film.unterschrift}<span class="g-film-hinweis" data-film-hinweis hidden> {rahmen.filmHinweis}</span></figcaption>
        </figure>
      )}
      {eintrag.bilder.map((eintragBild) => (
        <figure class="g-handy" data-ein>
          <div class="g-rahmen">
            <img src={bild(eintragBild.datei, 720)} srcset={quellen(eintragBild.datei)} sizes={GROESSEN} alt={eintragBild.alt} width="720" height="1620" loading="lazy" decoding="async" />
          </div>
          <figcaption>{eintragBild.unterschrift}</figcaption>
        </figure>
      ))}
      <p class="klein g-bildhinweis">{rahmen.bild}</p>
    </aside>

    <nav class="g-blaettern" aria-label={uebersicht.titel}>
      {davor ? (
        <a class="g-blatt zurueck" href={adresse(davor)}>
          <span>{rahmen.zurueck}</span>
          <b>{davor.titel}</b>
        </a>
      ) : (
        <a class="g-blatt zurueck" href={BEREICH}>
          <span>{uebersicht.titel}</span>
          <b>{rahmen.uebersicht}</b>
        </a>
      )}
      {danach ? (
        <a class="g-blatt weiter" href={adresse(danach)}>
          <span>{rahmen.weiter}</span>
          <b>{danach.titel}</b>
        </a>
      ) : (
        <a class="g-blatt weiter" href={BEREICH}>
          <span>{uebersicht.titel}</span>
          <b>{rahmen.uebersicht}</b>
        </a>
      )}
    </nav>
  </div>
</Basis>

<script>
  // Schleife statt Standbild, nur mit Bewegung. Die Datei wird erst geladen, wenn das Bild in die Nähe des Fensters
  // kommt. Der Knopf "Bewegung anhalten" im Kopfbereich hält die Schleife an und setzt sie fort.
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');
  const standbild = document.querySelector('img[data-film]');
  if (standbild && !ruhig.matches && 'IntersectionObserver' in window) {
    const beobachter = new IntersectionObserver((eintraege) => {
      if (!eintraege.some((eintrag) => eintrag.isIntersecting)) return;
      beobachter.disconnect();
      const film = document.createElement('video');
      film.muted = true;
      film.loop = true;
      film.playsInline = true;
      film.preload = 'auto';
      film.poster = standbild.currentSrc || standbild.src;
      film.width = standbild.width;
      film.height = standbild.height;
      film.setAttribute('aria-label', standbild.alt);
      film.src = standbild.dataset.film;
      const laeuft = () => !document.documentElement.classList.contains('angehalten') && !ruhig.matches;
      film.addEventListener('canplay', () => {
        standbild.replaceWith(film);
        document.querySelector('[data-film-hinweis]')?.removeAttribute('hidden');
        if (laeuft()) film.play().catch(() => {});
      }, { once: true });
      const folge = () => {
        if (laeuft()) film.play().catch(() => {});
        else film.pause();
      };
      // Der Knopf setzt die Klasse "angehalten" am html-Element; die Schleife folgt ihr.
      new MutationObserver(folge).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      ruhig.addEventListener('change', folge);
    }, { rootMargin: '200px' });
    beobachter.observe(standbild);
  }
</script>
