---
// "So geht's", ein Kapitel (AP-15 Teil B2, Karte C; neu gebaut in AP-19 Teil G; neu gestaltet in AP-23, Entwurf
// "Stationen"): eine Seite je Bereich der App. Jeder Abschnitt erklärt eine Funktion: der Nutzen, der kurze Weg in
// der App und bei den wichtigen Funktionen ein Bildschirmfoto im Handy-Rahmen. Jeder Abschnitt hat einen festen Anker
// aus den Daten. Alle Texte kommen aus src/daten/sogehts.mjs und src/daten/anleitung/.
// Gestaltung: Jeder Abschnitt ist eine Station an einer feinen Linie, mit seinem Symbol im Kreis und einer Karte
// daneben. Abschnitte mit "gross" in den Daten sind Lavendel-Karten mit Punktmuster, alle anderen weiße Karten. Das
// Bildschirmfoto steht in der Karte seines Abschnitts, am Laptop rechts neben dem Text, am Handy darunter; kein
// Skript hängt Bilder um. Links fährt am Laptop "In diesem Kapitel" als Liste mit; am Handy steht dieselbe Liste
// oben als Zeile aus Chips.
// Die Schleife steht im Kopf und läuft nur mit Bewegung: Ohne JavaScript und mit "Bewegung reduzieren" steht ihr
// Standbild da, und der Knopf "Bewegung anhalten" im Kopfbereich hält auch sie an.
import Basis from '../../../layouts/Basis.astro';
import Seitenkopf from '../../../components/Seitenkopf.astro';
import Handy from '../../../components/Handy.astro';
import Zeichen from '../../../components/Zeichen.astro';
import '../../../styles/sogehts.css';
import { seite } from '../../../daten/seite.mjs';
import { BEREICH, adresse, artVon, fotoDaten, kapitel, rahmen, uebersicht } from '../../../daten/sogehts.mjs';
import { metaVon } from '../../../daten/meta.mjs';
import { ueberApp } from '../../../daten/strukturiert.mjs';

export function getStaticPaths() {
  return kapitel.map((eintrag) => ({ params: { kapitel: eintrag.slug }, props: { slug: eintrag.slug } }));
}

const { slug } = Astro.props;
const stelle = kapitel.findIndex((eintrag) => eintrag.slug === slug);
const eintrag = kapitel[stelle];
const davor = kapitel[stelle - 1];
const danach = kapitel[stelle + 1];
const pfad = adresse(eintrag);
const ORDNER = '/bilder/sogehts/';
const BREITEN = [360, 720];
const bild = (name, breite) => `${ORDNER}${name}-${breite}.webp`;
const quellen = (name) => BREITEN.map((breite) => `${bild(name, breite)} ${breite}w`).join(', ');
// Die Angabe sagt dem Browser, wie breit das Bild auf der Seite ist: in der Karte neben dem Text (in der großen Karte
// etwas breiter), am Handy unter dem Text; die Schleife im Kopf.
const GROESSEN = { gross: '(min-width: 40rem) 12.5rem, 56vw', sonst: '(min-width: 40rem) 10.5rem, 56vw' };
const GROESSEN_FILM = '(min-width: 56rem) 12.5rem, 9.5rem';
// Das erste Foto der Seite lädt sofort, alle weiteren erst beim Scrollen.
const ersterTeilMitFoto = eintrag.teile.find((teil) => (teil.fotos ?? []).length > 0);
// Kopf: Mit Schleife stehen die Linienmotive wie im Entwurf (Zitronenscheibe oben, Blatt unten links); ohne Schleife
// gelten die Motive aller Unterseiten.
const kopf = {
  krumen: [{ titel: uebersicht.titel, ziel: BEREICH }, { titel: eintrag.titel, ziel: pfad }],
  etikett: `${uebersicht.kapitelWort} ${eintrag.nummer} von ${kapitel.length}`,
  titel: eintrag.h1,
  vorspann: eintrag.vorspann,
  vorspannLink: eintrag.vorspannLink,
  ...(eintrag.film && {
    motive: [
      { art: 'zitrone', breite: 150, lage: 'top: -40px; right: 30%', ecke: true },
      { art: 'blatt', breite: 120, lage: 'bottom: -20px; left: 4%', nurBreit: true },
    ],
  }),
};

// Gliederung für Suchmaschinen und KI-Antworten: das Kapitel als Artikel mit seinen Abschnitten. In den Daten steht
// nur, was auf der Seite sichtbar ist.
const daten = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: eintrag.titel,
  description: metaVon(pfad).beschreibung,
  inLanguage: 'de',
  mainEntityOfPage: seite.adresse + pfad,
  articleSection: eintrag.teile.map((teil) => teil.titel),
  isPartOf: { '@type': 'CollectionPage', name: uebersicht.titel, url: seite.adresse + BEREICH },
  publisher: { '@type': 'Organization', name: seite.name, url: seite.adresse },
  // Seit AP-35A: Verweis auf die App (feste Kennung, vollständig nur auf der Startseite).
  ...ueberApp,
}];
---
<Basis daten={daten}>
  {eintrag.film ? (
    <Seitenkopf {...kopf}>
      <figure class="g-film" slot="seite" data-schleife>
        <div class="geraet">
          <div class="geraet-rahmen">
            <img
              src={bild(`film-${eintrag.film.datei}`, 720)}
              srcset={quellen(`film-${eintrag.film.datei}`)}
              sizes={GROESSEN_FILM}
              alt={eintrag.film.alt}
              width="720"
              height="1620"
              fetchpriority="high"
              decoding="async"
              data-film={`${ORDNER}film-${eintrag.film.datei}.webm`}
            />
          </div>
        </div>
        <figcaption>{eintrag.film.unterschrift}<span class="g-film-hinweis" data-film-hinweis hidden> {rahmen.filmHinweis}</span></figcaption>
      </figure>
    </Seitenkopf>
  ) : (
    <Seitenkopf {...kopf} />
  )}
  <div class="s-inhalt innen">
    <div class="s-zwei">
      <nav class="s-leiste g-leiste" aria-labelledby="g-inhalt-titel">
        <h2 class="s-leiste-titel" id="g-inhalt-titel">{rahmen.inhalt}</h2>
        <ul>
          {eintrag.teile.map((teil) => <li><a href={`#${teil.anker}`}>{teil.titel}</a></li>)}
        </ul>
        <a class="g-alle" href={BEREICH}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {rahmen.uebersicht}
        </a>
      </nav>

      <div class="g-spalte">
        <article class="stationen g-text">
          {eintrag.teile.map((teil) => {
            const art = artVon(teil);
            const foto = teil.fotos?.[0] && fotoDaten(teil.fotos[0]);
            return (
              <section class:list={['station', 'g-funktion', `g-${art}`]} aria-labelledby={teil.anker} data-ein>
                {(teil.alteAnker ?? []).map((marke) => <span id={marke} class="g-alt-anker"></span>)}
                <span class="station-kreis" aria-hidden="true"><Zeichen name={teil.symbol} /></span>
                <div class:list={['g-karte', 's-karte', { 'lavendel muster': art === 'gross', 'g-mit-foto': foto }]}>
                  <div class="g-worte">
                    <h2 id={teil.anker}>{teil.titel}</h2>
                    {teil.nutzen && <p class="g-nutzen">{teil.nutzen}</p>}
                    {teil.wo && (
                      <p class="g-wo"><Zeichen name="wegweiser" /><span><b>{rahmen.wo}:</b> {teil.wo.split(' > ').map((stueck, nummer) => <>{nummer > 0 && <i> &gt; </i>}{stueck}</>)}</span></p>
                    )}
                    {teil.liste && (
                      <dl class="r-stufen">
                        {teil.liste.map((punkt) => <div><dt>{punkt.name}</dt><dd>{punkt.text}</dd></div>)}
                      </dl>
                    )}
                    {(teil.absaetze ?? []).map((absatz) => <p>{absatz}</p>)}
                    {teil.verweis && <p>{teil.verweis.vor}<a href={teil.verweis.ziel}>{teil.verweis.text}</a>{teil.verweis.nach}</p>}
                  </div>
                  {foto && (
                    <figure class="g-foto">
                      <Handy foto={foto} groessen={art === 'gross' ? GROESSEN.gross : GROESSEN.sonst} laden={teil === ersterTeilMitFoto ? 'eager' : 'lazy'} />
                      <figcaption>{foto.unterschrift}</figcaption>
                    </figure>
                  )}
                </div>
              </section>
            );
          })}
        </article>

        <p class="klein g-bildhinweis">{rahmen.bild}</p>
        {eintrag.verweise && (
          <div class="g-mehr">
            <h2>{rahmen.mehr}</h2>
            <ul class="chips">
              {eintrag.verweise.map((verweis) => <li><a class="chip" href={verweis.ziel}>{verweis.text}</a></li>)}
            </ul>
          </div>
        )}

        <nav class="g-blaettern" aria-label={uebersicht.titel}>
          {davor ? (
            <a class="g-blatt zurueck" href={adresse(davor)}>
              <span><Zeichen name="pfeil" />{rahmen.zurueck}</span>
              <b>{davor.titel}</b>
            </a>
          ) : (
            <a class="g-blatt zurueck" href={BEREICH}>
              <span><Zeichen name="pfeil" />{uebersicht.titel}</span>
              <b>{rahmen.uebersicht}</b>
            </a>
          )}
          {danach ? (
            <a class="g-blatt weiter" href={adresse(danach)}>
              <span>{rahmen.weiter}<Zeichen name="pfeil" /></span>
              <b>{danach.titel}</b>
            </a>
          ) : (
            <a class="g-blatt weiter" href={BEREICH}>
              <span>{uebersicht.titel}<Zeichen name="pfeil" /></span>
              <b>{rahmen.uebersicht}</b>
            </a>
          )}
        </nav>
      </div>
    </div>
  </div>
</Basis>

<script>
  // Schleife im Kopf statt des Standbilds, nur mit Bewegung. Ohne Skript und mit "Bewegung reduzieren" bleibt das
  // Standbild stehen. Die Datei wird erst geladen, wenn das Bild in die Nähe des Fensters kommt. Der Knopf "Bewegung
  // anhalten" im Kopfbereich setzt die Klasse "angehalten" am html-Element: Die Schleife hält dann an. Sie hält auch,
  // solange sie nicht im Fenster zu sehen ist.
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');
  const wurzel = document.documentElement;
  const standbild = document.querySelector('img[data-film]');
  if (standbild && !ruhig.matches && 'IntersectionObserver' in window) {
    let film;
    let zuSehen = true;
    const folge = () => {
      if (!film) return;
      if (zuSehen && !wurzel.classList.contains('angehalten') && !ruhig.matches) film.play().catch(() => {});
      else film.pause();
    };
    const beobachter = new IntersectionObserver((eintraege) => {
      if (!eintraege.some((eintrag) => eintrag.isIntersecting)) return;
      beobachter.disconnect();
      const neu = document.createElement('video');
      neu.muted = true;
      neu.loop = true;
      neu.playsInline = true;
      neu.preload = 'auto';
      neu.poster = standbild.currentSrc || standbild.src;
      neu.width = standbild.width;
      neu.height = standbild.height;
      neu.setAttribute('aria-label', standbild.alt);
      neu.src = standbild.dataset.film;
      neu.addEventListener('canplay', () => {
        standbild.replaceWith(neu);
        film = neu;
        document.querySelector('[data-film-hinweis]')?.removeAttribute('hidden');
        new IntersectionObserver((stand) => { zuSehen = stand.at(-1).isIntersecting; folge(); }).observe(neu);
        folge();
      }, { once: true });
      // Der Knopf setzt die Klasse "angehalten" am html-Element; die Schleife folgt ihr.
      new MutationObserver(folge).observe(wurzel, { attributes: true, attributeFilter: ['class'] });
      ruhig.addEventListener('change', folge);
    }, { rootMargin: '200px' });
    beobachter.observe(standbild);
  }
</script>
