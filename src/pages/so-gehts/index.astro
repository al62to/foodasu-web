---
// "So geht's", Übersicht (AP-15 Teil B2, Karte C; neu gestaltet in AP-23, Entwurf "Ein Weg"): der Kopf steht mittig
// auf der Lavendel-Fläche, darunter liegen die acht Kapitel als Stationen an einer feinen Linie. Am Laptop läuft die
// Linie durch die Mitte: Die Nummer sitzt im Kreis auf der Linie, auf der einen Seite steht die weiße Karte, auf der
// anderen das Handy mit dem Leitbild des Kapitels, von Station zu Station abwechselnd. Am Handy läuft die Linie
// links, und das Handy steht klein in der Karte. Die Linie endet an der Karte mit dem Hinweis zur Verpackung.
// Alle Texte kommen aus src/daten/sogehts.mjs. Die Bilder schmücken nur (der Inhalt steht als Text daneben); sie
// tragen ihre Beschreibung, sind für Bildschirmleser aber ausgeblendet, damit der Name des Links kurz bleibt.
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Handy from '../../components/Handy.astro';
import '../../styles/sogehts.css';
import { seite } from '../../daten/seite.mjs';
import { BEREICH, adresse, kapitel, leitbildVon, uebersicht } from '../../daten/sogehts.mjs';

// Gliederung für Suchmaschinen und KI-Antworten: die Kapitel als Liste. In den Daten steht nur, was auf der Seite
// sichtbar ist.
const daten = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: uebersicht.titel,
  itemListElement: kapitel.map((eintrag) => ({
    '@type': 'ListItem',
    position: eintrag.nummer,
    name: eintrag.titel,
    url: seite.adresse + adresse(eintrag),
  })),
}];
// Linienmotive im Kopf wie im Entwurf: Zitronenscheibe links, Ähre rechts. Am Handy lägen sie hinter dem Text.
const MOTIVE = [
  { art: 'zitrone', breite: 170, lage: 'top: 40px; left: 5%', nurBreit: true },
  { art: 'aehre', breite: 100, lage: 'top: 30px; right: 7%', nurBreit: true },
];
// Breite des Handys: am Laptop neben der Linie, am Handy klein in der Karte.
const GROESSEN = '(min-width: 48rem) 7rem, 4.5rem';
---
<Basis daten={daten}>
  <Seitenkopf krumen={[{ titel: uebersicht.titel, ziel: BEREICH }]} titel={uebersicht.h1} vorspann={uebersicht.vorspann} mittig motive={MOTIVE} />
  <div class="s-inhalt innen">
    <ol class="stationen g-weg">
      {kapitel.map((eintrag, stelle) => (
        <li class="station g-halt" data-ein>
          <span class="station-kreis" aria-hidden="true">{eintrag.nummer}</span>
          <a class="g-kachel" href={adresse(eintrag)}>
            <div class="g-kachel-text">
              <span class="vh">{uebersicht.kapitelWort} {eintrag.nummer}: </span>
              <b>{eintrag.titel}</b>
              <span class="g-kurz">{eintrag.kurz}</span>
              <span class="g-lesen" aria-hidden="true">
                {uebersicht.lesen}
                <svg viewBox="0 0 24 24" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </div>
            <div class="g-kachel-bild" aria-hidden="true">
              <Handy foto={leitbildVon(eintrag)} groessen={GROESSEN} laden={stelle === 0 ? 'eager' : 'lazy'} schnitt={false} />
            </div>
          </a>
        </li>
      ))}
    </ol>
    <div class="s-karte g-hinweis" data-ein>
      <p>{uebersicht.hinweis}</p>
      <p>{uebersicht.fragen.vor}<a href={uebersicht.fragen.ziel}>{uebersicht.fragen.text}</a>{uebersicht.fragen.nach}</p>
    </div>
  </div>
</Basis>
