---
// Kopfbereich der Unterseiten (AP-23 Teil B Nr. 7): helle Lavendel-Fläche mit Punktmuster und blassen Linienmotiven,
// dunkle Schrift, Brotkrumen in Grau. "mittig" stellt alles in die Mitte, "klein" ist der niedrigere Kopf der
// Übersichten und Rechtstexte. "motive" nennt die Linienmotive (src/components/Motive.astro, höchstens drei).
// Platz "seite": rechte Spalte am Laptop (zum Beispiel das Bild eines Rezepts oder die Schleife eines Kapitels).
// Läuft auf der Seite eine Schleife (ein Element mit data-schleife), gibt es den Knopf "Bewegung anhalten"
// (WCAG 2.2.2); sein Zustand steht nur in einer Variablen der Seite, im Browser wird nichts gespeichert.
import '../styles/seiten.css';
import Brotkrumen from './Brotkrumen.astro';
import Motive from './Motive.astro';
import { geruest } from '../daten/startseite.mjs';

// "vorzeile" (AP-22, Überschriften mit Suchwort): eine kleine Zeile über dem Titel, die zur h1 gehört, zum Beispiel
// "Rezept" über dem Namen des Gerichts. Bildschirmleser lesen sie mit Doppelpunkt vor dem Titel.
// "etikett" ist eine kleine Zeile über der h1, die nicht zu ihr gehört (zum Beispiel "Kapitel 3 von 8").
// "vorspannLink" ({ vor, text, nach, ziel }) hängt einen Satz mit Link an den Vorspann an, im selben Absatz (Auftrag SEO 1
// neu, Teil 4 Nr. 1: Link mit dem Ankertext "Einkaufslisten-App" zur Startseite).
const STANDARD = [
  { art: 'aehre', breite: 120, lage: 'top: 14px; right: 8%', nurBreit: true },
  { art: 'zitrone', breite: 130, lage: 'bottom: -50px; right: 32%', ecke: true },
];
const { krumen, titel, vorspann, vorspannLink, etikett, vorzeile, mittig = false, klein = false, motive = STANDARD } = Astro.props;
const zwei = Astro.slots.has('seite');
---
<button type="button" class="bewegung-knopf" data-bewegung-seite data-anhalten={geruest.bewegung.anhalten} data-fortsetzen={geruest.bewegung.fortsetzen} hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="z-halt" d="M8 5v14M16 5v14" /><path class="z-lauf" d="M8 5l11 7-11 7z" /></svg>
  <span data-bewegung-text>{geruest.bewegung.anhalten}</span>
</button>
<div class:list={['s-kopf', 'muster', { mittig, 'klein-kopf': klein }]}>
  <Motive liste={motive} />
  <div class="innen">
    {krumen && <Brotkrumen pfad={krumen} />}
    <div class:list={['s-kopf-raster', { zwei }]}>
      <div class="s-kopf-text">
        {etikett && <p class="ueberzeile">{etikett}</p>}
        {vorzeile
          ? <h1><span class="s-vorzeile">{vorzeile}<span class="vh">: </span></span><span data-titel-kern><slot name="titel">{titel}</slot></span></h1>
          : <h1><slot name="titel">{titel}</slot></h1>}
        {vorspann && <p class="s-vorspann">{vorspann}{vorspannLink && <>{' '}{vorspannLink.vor}<a href={vorspannLink.ziel}>{vorspannLink.text}</a>{vorspannLink.nach}</>}</p>}
        <slot />
      </div>
      {zwei && <slot name="seite" />}
    </div>
  </div>
</div>

<script>
  // Einblenden beim Scrollen, Neigung der Karten am Laptop und der Knopf "Bewegung anhalten". Ohne GSAP: Auf den
  // Unterseiten reichen CSS und ein Beobachter. Mit "Bewegung reduzieren" bewegt sich nichts.
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');
  const fein = window.matchMedia('(hover: hover) and (min-width: 56rem)');
  const wurzel = document.documentElement;
  const knopf = document.querySelector('[data-bewegung-seite]');
  const teile = [...document.querySelectorAll('[data-ein]')];
  let angehalten = false;

  const zeigeAlle = () => teile.forEach((teil) => teil.classList.add('da'));
  if (!ruhig.matches && 'IntersectionObserver' in window) {
    const beobachter = new IntersectionObserver(
      (eintraege) => {
        for (const eintrag of eintraege) {
          if (!eintrag.isIntersecting) continue;
          eintrag.target.classList.add('da');
          beobachter.unobserve(eintrag.target);
        }
      },
      { rootMargin: '0px 0px -6% 0px' }
    );
    // Was beim Laden schon im Fenster steht, bleibt ohne Bewegung sichtbar.
    for (const teil of teile) {
      if (teil.getBoundingClientRect().top < window.innerHeight) teil.classList.add('da');
      else beobachter.observe(teil);
    }
    wurzel.classList.add('ein');
  } else {
    zeigeAlle();
  }

  const ruhe = (karte) => {
    karte.style.removeProperty('--nx');
    karte.style.removeProperty('--ny');
  };
  for (const karte of document.querySelectorAll('[data-neigung]')) {
    karte.addEventListener('pointermove', (ereignis) => {
      if (ereignis.pointerType !== 'mouse' || !fein.matches || ruhig.matches || angehalten) return;
      const rahmen = karte.getBoundingClientRect();
      const x = (ereignis.clientX - rahmen.left) / rahmen.width - 0.5;
      const y = (ereignis.clientY - rahmen.top) / rahmen.height - 0.5;
      karte.style.setProperty('--ny', `${(x * 7).toFixed(2)}deg`);
      karte.style.setProperty('--nx', `${(-y * 7).toFixed(2)}deg`);
    });
    karte.addEventListener('pointerleave', () => ruhe(karte));
  }

  if (knopf) {
    const schleife = document.querySelector('[data-schleife]');
    const zeige = () => { knopf.hidden = ruhig.matches || !schleife; };
    zeige();
    knopf.addEventListener('click', () => {
      angehalten = !angehalten;
      wurzel.classList.toggle('angehalten', angehalten);
      knopf.querySelector('[data-bewegung-text]').textContent = angehalten ? knopf.dataset.fortsetzen : knopf.dataset.anhalten;
      if (angehalten) {
        zeigeAlle();
        document.querySelectorAll('[data-neigung]').forEach(ruhe);
      }
    });
    ruhig.addEventListener('change', () => {
      zeige();
      if (ruhig.matches) zeigeAlle();
    });
  }
</script>
