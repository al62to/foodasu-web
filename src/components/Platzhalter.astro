---
// Platzhalterseite "Kommt bald": nicht im Index der Suchmaschinen und nicht in der Sitemap.
import Basis from '../layouts/Basis.astro';
import Seitenkopf from './Seitenkopf.astro';
import { seite } from '../daten/seite.mjs';

const { texte } = Astro.props;
---
<Basis titel={`${texte.titel} | ${seite.name}`} beschreibung={texte.beschreibung} index={false}>
  <Seitenkopf krumen={[{ titel: texte.titel, ziel: Astro.url.pathname }]} titel={texte.titel} vorspann={texte.text} />
  <div class="s-inhalt innen platzhalter">
    <slot />
  </div>
</Basis>
