---
// Platzhalterseite "Kommt bald": nicht im Index der Suchmaschinen und nicht in der Sitemap.
import Basis from '../layouts/Basis.astro';
import { seite } from '../daten/seite.mjs';

const { texte } = Astro.props;
---
<Basis titel={`${texte.titel} | ${seite.name}`} beschreibung={texte.beschreibung} krumen={[{ titel: texte.titel, ziel: Astro.url.pathname }]} index={false}>
  <section class="abschnitt platzhalter">
    <div class="innen schmal">
      <h1>{texte.titel}</h1>
      <p class="vorspann">{texte.text}</p>
      <slot />
    </div>
  </section>
</Basis>
