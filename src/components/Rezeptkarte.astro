---
// Karte eines Rezepts mit Symbolbild; die ganze Karte führt zum Rezept. Am Laptop neigt sie sich leicht unter dem
// Mauszeiger (Skript in Seitenkopf.astro). Mit "filter" trägt sie die Angaben für Suche und Filter der Übersicht;
// mit "land" steht unter dem Titel das Land statt der Zeit (Übersicht nach Entwurf 1).
import { texte, KATEGORIE, LAND, dauer, rezeptAdresse, ziel, filterAngaben } from '../daten/rezeptseiten.mjs';

const { rezept, vorn = false, filter = false, ein = true, land = false } = Astro.props;
const adresse = ziel(rezeptAdresse(rezept));
const bild = (endung, breite = 360) => `/bilder/rezepte/${rezept.slug}-karte-${breite}.${endung}`;
const quellen = (endung) => [360, 720].map((breite) => `${bild(endung, breite)} ${breite}w`).join(', ');
const groessen = '(min-width: 48rem) 17rem, 46vw';
const zusatz = land ? LAND[rezept.laender[0]] : rezept.zeitGesamt != null ? dauer(rezept.zeitGesamt) : null;
const zeile = [KATEGORIE[rezept.kategorie][0], zusatz].filter(Boolean).join(' · ');
const angaben = filter ? filterAngaben(rezept) : {};
---
<li class="r-karte" data-neigung data-ein={ein && !vorn ? '' : undefined} data-karte={filter ? '' : undefined} data-kategorie={angaben.kategorie} data-land={angaben.land} data-passt={angaben.passt} data-text={angaben.text}>
  <div class="r-karte-bild">
    <picture>
      <source type="image/avif" srcset={quellen('avif')} sizes={groessen} />
      <img src={bild('webp')} srcset={quellen('webp')} sizes={groessen} alt={`${texte.symbolbild}: ${rezept.titel}`} width="360" height="270" loading={vorn ? 'eager' : 'lazy'} decoding="async" />
    </picture>
    <span class="r-symbol" aria-hidden="true">{texte.symbolbild}</span>
  </div>
  <p class="r-karte-titel">{adresse ? <a href={adresse}>{rezept.titel}</a> : rezept.titel}</p>
  <p class="r-karte-zeile">{zeile}</p>
</li>
