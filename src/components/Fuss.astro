---
// Fuß: Rechtliches, Kontakt, Auftritte als einfache Links mit lokalen Symbolen (keine Einbettungen, keine Zähler).
import { auftritte, store } from '../daten/seite.mjs';
import { fuss } from '../daten/startseite.mjs';
import kontakt from '../inhalte/kontakt.html?raw';

// Die Adresse bleibt wie auf der veröffentlichten Seite als Zeichenfolge aus HTML-Entitäten im Quelltext.
const kontaktLink = `<a href="${kontakt.trim()}">${fuss.links.kontakt}</a>`;
---
<footer class="fuss">
  <div class="innen fuss-innen">
    <ul>
      <li><a href="/datenschutz.html">{fuss.links.datenschutz}</a></li>
      <li><a href="/#offenlegung">{fuss.links.offenlegung}</a></li>
      <li><a href="/lizenzen/">{fuss.links.lizenzen}</a></li>
      <li><a href="/quellen-und-lizenzen/">{fuss.links.quellen}</a></li>
      <li set:html={kontaktLink} />
    </ul>
    <ul>
      {auftritte.facebook && (
        <li>
          <a href={auftritte.facebook} rel="me noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.7V21z" /></svg>
            {fuss.auftritte.facebook}
          </a>
        </li>
      )}
      {auftritte.instagram && (
        <li>
          <a href={auftritte.instagram} rel="me noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 2h8a6 6 0 0 1 6 6v8a6 6 0 0 1-6 6H8a6 6 0 0 1-6-6V8a6 6 0 0 1 6-6zm0 2a4 4 0 0 0-4 4v8a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4V8a4 4 0 0 0-4-4zm4 3a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm5.3-3.5a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z" /></svg>
            {fuss.auftritte.instagram}
          </a>
        </li>
      )}
      <li>
        {store.oeffentlich ? (
          <a href={store.adresse} rel="me noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 3.6v16.8a1 1 0 0 0 1.5.9l14-8.4a1 1 0 0 0 0-1.8l-14-8.4A1 1 0 0 0 5 3.6z" /></svg>
            {fuss.auftritte.storeLink}
          </a>
        ) : (
          <span class="bald"><span>{fuss.auftritte.storeBald}</span></span>
        )}
      </li>
    </ul>
    <p class="hinweis">{fuss.hinweis}</p>
  </div>
</footer>
