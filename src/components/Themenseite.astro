---
// Themenseite: alle Rezepte der Website zu einem Eintrag, Land oder einer Kategorie, mit ItemList. Seiten ab sechs
// Rezepten zeigen über den Karten ihren eigenen Einleitungstext (src/daten/themen_texte.mjs, AP-22).
// Aufbau seit AP-23 wie die Übersicht, ohne Seitenleiste: kleiner Kopf auf der Lavendel-Fläche, alle Rezepte des
// Themas als Karten in voller Breite (vier Spalten am Laptop), "Je nach Produkt" als Lavendel-Kasten, "Verwandte
// Themen" als Chips. Alle Rezepte stehen sichtbar im HTML; nichts wird nachgeladen.
import Basis from '../layouts/Basis.astro';
import Seitenkopf from './Seitenkopf.astro';
import Rezeptkarte from './Rezeptkarte.astro';
import '../styles/rezepte.css';
import { seite } from '../daten/seite.mjs';
import { alleThemen, texte, verwandte, ziel, rezeptAdresse } from '../daten/rezeptseiten.mjs';

const { adresse } = Astro.props;
const thema = alleThemen.find((eintrag) => eintrag.adresse === adresse);
const zeigtZutaten = ['ohne', 'passt'].includes(thema.art);
const text = thema.text(thema.rezepte.length);
const nah = verwandte(thema).filter((anderes) => ziel(anderes.adresse));
const jeNach = thema.jeNachRezepte.filter((rezept) => ziel(rezeptAdresse(rezept)));
const daten = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: thema.titel,
  numberOfItems: thema.rezepte.length,
  itemListElement: thema.rezepte.map((rezept, nummer) => ({
    '@type': 'ListItem', position: nummer + 1, url: seite.adresse + rezeptAdresse(rezept),
  })),
}];
---
<Basis daten={daten}>
  <Seitenkopf
    krumen={[{ titel: texte.uebersicht, ziel: '/rezepte/' }, { titel: thema.titel, ziel: adresse }]}
    titel={thema.titel}
    vorspann={`${text} ${texte.thema.inDerApp(thema.inDerApp)}`}
    klein
    motive={[
      { art: 'aehre', breite: 120, lage: 'top: 10px; right: 120px', nurBreit: true },
      { art: 'zitrone', breite: 130, lage: 'bottom: -50px; right: 360px', ecke: true },
    ]}
  >
    {zeigtZutaten && <p class="klein">{texte.thema.grundlage}</p>}
  </Seitenkopf>

  <div class="s-inhalt innen">
    {thema.einleitung && <p class="s-teil t-einleitung">{thema.einleitung}</p>}
    <ul class="r-karten flach vier s-teil">{thema.rezepte.map((rezept, nummer) => <Rezeptkarte rezept={rezept} vorn={nummer < 4} />)}</ul>

    {jeNach.length > 0 && (
      <section class="s-teil t-je-nach" aria-labelledby="je-nach">
        <h2 id="je-nach">{texte.thema.jeNachTitel}</h2>
        <p>{thema.jeNachText}</p>
        <ul class="chips">
          {jeNach.map((rezept) => <li><a class="chip" href={rezeptAdresse(rezept)}>{rezept.titel}</a></li>)}
        </ul>
      </section>
    )}

    {nah.length > 0 && (
      <section class="s-teil t-verwandt" aria-labelledby="verwandt">
        <h2 id="verwandt">{texte.thema.verwandt}</h2>
        <ul class="chips">
          {nah.map((anderes) => <li><a class="chip" href={anderes.adresse}>{anderes.titel}</a></li>)}
        </ul>
      </section>
    )}
  </div>
</Basis>
