---
// Seite eines Rezepts (Aufbau seit AP-23 nach Entwurf "Schritt für Schritt"). Alle Angaben kommen aus dem
// Rezeptpaket, die festen Wörter aus src/daten/rezeptseiten.mjs. Kopfbereich auf der Lavendel-Fläche mit drei großen
// Angaben und dem Symbolbild, darunter eine Sprungleiste; Zutaten in zwei Spalten, ein Schritt je Karte, die Hinweise
// nach Stufe gruppiert (die Tabelle bleibt als Umschalter), Nährwerte als Kacheln. Quelle und Lizenz stehen auf der
// Seite "Quellen und Lizenzen"; hier führt ein Link dorthin. Die strukturierten Daten (Recipe) sind unverändert.
import Basis from '../layouts/Basis.astro';
import Seitenkopf from './Seitenkopf.astro';
import Motive from './Motive.astro';
import Rezeptkarte from './Rezeptkarte.astro';
import '../styles/rezepte.css';
import { seite, store } from '../daten/seite.mjs';
import { fuss } from '../daten/startseite.mjs';
import {
  rezepte, texte, LAND, KATEGORIE, AUFWAND, ENERGIE, QUELLE, NAEHRWERT, STAND, ausLand, zahl, dauer, iso, portionen,
  zutatText, hinweiseVon, hinweisText, ohneHinweis, ernaehrung, einleitung, themaZu, ziel, aehnliche, schrittName, rezeptAdresse,
  quelleAdresse, EINTRAEGE, kommtSpaeter, alteRezepte, rezepte as alleRezepte,
} from '../daten/rezeptseiten.mjs';

const { slug } = Astro.props;
const rezept = rezepte.find((eintrag) => eintrag.slug === slug);
const adresse = rezeptAdresse(rezept);
const voll = seite.adresse + adresse;
const eintragVon = new Map(EINTRAEGE.map((eintrag) => [eintrag.schluessel, eintrag]));
const text = einleitung(rezept);

const bild = (name, endung) => `/bilder/rezepte/${rezept.slug}-${name}.${endung}`;
const quellen = (endung) => [720, 1200].map((breite) => `${bild(`4x3-${breite}`, endung)} ${breite}w`).join(', ');
const hinweise = hinweiseVon(rezept);
const ohne = ohneHinweis(rezept);
const formen = [['en:vegan', 'vegan'], ['en:vegetarian', 'vegetarisch']].map(([schluessel, form]) => ({ schluessel, form, stand: ernaehrung(rezept, schluessel) }));
const vegan = formen[0].stand === 'voll';
const moeglich = formen.filter(({ stand }) => stand === 'moeglich').map(({ schluessel, form }) => ({
  form,
  zutaten: rezept.zutaten.filter((zutat) => zutat.hinweise.some((h) => h.eintrag === schluessel)).map((zutat) => zutat.grundbegriff),
}));
const gruppen = [];
for (const zutat of rezept.zutaten) {
  if (!gruppen.length || gruppen.at(-1).name !== zutat.gruppe) gruppen.push({ name: zutat.gruppe, zutaten: [] });
  gruppen.at(-1).zutaten.push(zutat);
}
const menge = portionen(rezept);
const proPortion = rezept.nwVollstaendig && rezept.portion;
const stueck = rezept.portionenEinheit === 'STUECK';
const spalte = stueck ? texte.naehrwerte.spalteStueck : texte.naehrwerte.spaltePortion;
const stufe = rezept.energiedichte ? ENERGIE.stufen.indexOf(rezept.energiedichte) + 1 : 0;
// Rezepte, die später in die App kommen (AP-25); bei denen aus alten Kochbüchern stehen die Angaben zum Buch dabei.
const spaeter = kommtSpaeter(rezept);
const original = rezept.original;
const heutige = original?.gleiches_gericht ? alleRezepte.find((anderes) => anderes.slug === original.gleiches_gericht) : null;
const alteFassungen = alteRezepte.filter((anderes) => anderes.original.gleiches_gericht === rezept.slug);
const urheberName = original ? null : QUELLE[rezept.quelle][1];
const themenLinks = [
  ...rezept.laender.map((kuerzel) => themaZu('land', kuerzel)),
  themaZu('kategorie', rezept.kategorie),
].filter((thema) => thema && ziel(thema.adresse));
const landThema = (kuerzel) => { const thema = themaZu('land', kuerzel); return thema && ziel(thema.adresse); };
const kategorieThema = themaZu('kategorie', rezept.kategorie);
const nah = aehnliche(rezept);

// Hinweise einer Zutat, je Stufe zusammengefasst: "Enthält: Gluten, Eier", "Je nach Produkt mit: Soja".
const STUFEN = ['IST', 'MEIST_MIT', 'JE_NACH_PRODUKT'];
const jeZutat = (zutat) => STUFEN.map((stufe, nummer) => ({
  wort: nummer === 2 ? `${texte.hinweise.stufen[2][0]} mit` : texte.hinweise.stufen[nummer][0],
  namen: zutat.hinweise.filter((h) => h.stufe === stufe).map((h) => (stufe === 'IST' ? eintragVon.get(h.eintrag).enthaelt : eintragVon.get(h.eintrag).mit)),
})).filter((zeile) => zeile.namen.length);
// Hinweise des Rezepts nach Stufe gruppiert: je Stufe die Einträge mit ihren Zutaten. Ein Eintrag, dessen Name nicht
// sagt, was gemeint ist ("Vegetarisch"), steht mit seiner Form nach "Enthält" da ("nicht vegetarische Zutaten").
const jeStufe = STUFEN.map((stufe, nummer) => ({
  wort: texte.hinweise.stufen[nummer][0],
  erklaerung: texte.hinweise.stufen[nummer][1],
  art: ['voll', 'halb', 'offen'][nummer],
  zeilen: hinweise.flatMap(({ eintrag, stufen }) => stufen.filter((zeile) => zeile.stufe === stufe).map((zeile) => ({
    name: eintrag.name === eintrag.enthaelt ? eintrag.name : `${eintrag.name}: ${eintrag.enthaelt}`,
    zutaten: zeile.zutaten.join(', '),
  }))),
}));
// Sprungleiste unter dem Kopf: die fünf Abschnitte der Seite mit ihren Ankern.
const sprung = [
  ...(original ? [['original', texte.sprung.original]] : []),
  ['zutaten', texte.zutaten.titel], ['zubereitung', texte.schritte.titel], ['hinweise', texte.sprung.hinweise],
  ['naehrwerte', texte.naehrwerte.titel], ['app', texte.sprung.app],
];
// Die drei großen Angaben im Kopf; fehlt die Gesamtzeit im Rezeptpaket, sind es zwei.
const gross = [
  rezept.zeitGesamt != null && ['Gesamt', dauer(rezept.zeitGesamt)],
  menge && [stueck ? 'Stück' : 'Portionen', String(rezept.portionen)],
  ['Aufwand', AUFWAND[rezept.aufwand]],
].filter(Boolean);
const linien = { fill: 'none', stroke: 'currentColor', 'stroke-width': '2.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' };

const kochen = rezept.zeitGesamt != null && rezept.zeitVorbereitung != null ? rezept.zeitGesamt - rezept.zeitVorbereitung : null;
const schluesselwoerter = [
  ...formen.filter(({ stand }) => stand === 'voll').map(({ form }) => form),
  `Aufwand ${AUFWAND[rezept.aufwand]}`,
  ...[...new Set(rezept.zutaten.map((zutat) => zutat.grundbegriff))].slice(0, 5),
];
const daten = [{
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  '@id': `${voll}#rezept`,
  name: rezept.titel,
  url: voll,
  mainEntityOfPage: voll,
  inLanguage: 'de',
  image: ['16x9-1200', '4x3-1200', '1x1-1200'].map((name) => seite.adresse + bild(name, 'webp')),
  description: text,
  author: [
    { '@type': 'Organization', name: seite.name, url: `${seite.adresse}/` },
    ...(original ? [] : [{ '@type': 'Organization', name: urheberName, url: rezept.urheberUrl }]),
  ],
  publisher: { '@type': 'Organization', name: seite.name, url: `${seite.adresse}/` },
  // Rezepte aus alten Kochbüchern nennen das Buch (Titel, Verfasser, Erscheinungsjahr); die heutige Fassung ist von FoodAsu.
  ...(original
    ? { isBasedOn: { '@type': 'Book', name: original.buch, ...(original.todesjahr ? { author: { '@type': 'Person', name: original.verfasser } } : {}), datePublished: String(original.jahr), inLanguage: original.sprache_kennung, url: original.digitalisat ?? original.abschrift } }
    : { isBasedOn: rezept.quelleUrl, license: rezept.lizenzUrl }),
  datePublished: STAND,
  ...(rezept.zeitGesamt != null ? { totalTime: iso(rezept.zeitGesamt) } : {}),
  ...(kochen != null && kochen >= 0 ? { prepTime: iso(rezept.zeitVorbereitung), cookTime: iso(kochen) } : {}),
  ...(menge ? { recipeYield: [String(rezept.portionen), menge] } : {}),
  recipeCategory: KATEGORIE[rezept.kategorie][0],
  recipeCuisine: rezept.kueche,
  keywords: schluesselwoerter.join(', '),
  recipeIngredient: rezept.zutaten.map(zutatText),
  recipeInstructions: rezept.schritte.map((schritt, nummer) => ({
    '@type': 'HowToStep', name: schrittName(schritt), text: schritt, url: `${voll}#schritt-${nummer + 1}`,
  })),
  ...(formen[1].stand === 'voll' ? { suitableForDiet: vegan ? ['https://schema.org/VeganDiet', 'https://schema.org/VegetarianDiet'] : ['https://schema.org/VegetarianDiet'] } : {}),
  ...(proPortion && menge ? { nutrition: { '@type': 'NutritionInformation', calories: `${Math.round(rezept.portion.kcal)} kcal`, servingSize: stueck ? '1 Stück' : '1 Portion' } } : {}),
}];
---
<Basis daten={daten}>
  <article class="rezept">
    <Seitenkopf
      krumen={[{ titel: texte.uebersicht, ziel: '/rezepte/' }, { titel: rezept.kurztitel, ziel: adresse }]}
      titel={rezept.titel}
      vorzeile={texte.rezeptVorzeile}
      vorspann={text}
      motive={[
        { art: 'zitrone', breite: 170, lage: 'top: -40px; right: 40px', ecke: true },
        { art: 'blatt', breite: 140, lage: 'bottom: -30px; left: -20px', nurBreit: true },
        { art: 'aehre', breite: 80, lage: 'bottom: 24px; left: 47%', nurBreit: true },
      ]}
    >
      <dl class="r-angaben">
        {gross.map(([name, wert]) => <div><dt>{name}</dt><dd>{wert}</dd></div>)}
      </dl>
      <dl class="r-zeile">
        {rezept.zeitVorbereitung != null && <div><dt>Vorbereitung</dt><dd>{dauer(rezept.zeitVorbereitung)}</dd></div>}
        <div><dt>Land</dt><dd>{rezept.laender.map((kuerzel, nummer) => <>{nummer > 0 && ', '}{landThema(kuerzel) ? <a href={landThema(kuerzel)} aria-label={`Rezepte ${ausLand(kuerzel)}`}>{LAND[kuerzel]}</a> : LAND[kuerzel]}</>)}</dd></div>
        <div><dt>Kategorie</dt><dd>{kategorieThema && ziel(kategorieThema.adresse) ? <a href={kategorieThema.adresse} aria-label={kategorieThema.titel}>{KATEGORIE[rezept.kategorie][0]}</a> : KATEGORIE[rezept.kategorie][0]}</dd></div>
        {stufe > 0 && <div><dt>{texte.naehrwerte.energie}</dt><dd>{ENERGIE.wort[rezept.energiedichte]}</dd></div>}
      </dl>
      <p class="r-teilen">
        <button type="button" class="knopf voll r-teilen-knopf" data-teilen data-titel={rezept.titel} data-text={texte.teilen.satz(rezept.kurztitel)} data-adresse={voll} data-kopiert={texte.teilen.kopiert} data-fehler={texte.teilen.fehler}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 10.5l6.8-4M8.6 13.5l6.8 4" /></svg>
          {texte.teilen.knopf}
        </button>
        <span class="r-teilen-status" role="status" data-teilen-status></span>
      </p>
      <figure class="r-bild" slot="seite">
        <picture>
          <source type="image/avif" srcset={quellen('avif')} sizes="(min-width: 56rem) 31rem, 100vw" />
          <img src={bild('4x3-1200', 'webp')} srcset={quellen('webp')} sizes="(min-width: 56rem) 31rem, 100vw" alt={`${texte.symbolbild}: ${rezept.titel}`} width="1200" height="900" fetchpriority="high" decoding="async" />
        </picture>
        <figcaption class="r-symbol">{texte.symbolbild}</figcaption>
      </figure>
    </Seitenkopf>

    <nav class="r-sprung" aria-label={texte.sprung.titel} data-sprung>
      <ul class="innen">
        {sprung.map(([anker, name]) => <li><a href={`#${anker}`}>{name}</a></li>)}
      </ul>
    </nav>

    <div class="s-inhalt innen r-inhalt">
      {original && (
        <section class="r-teil r-original muster" aria-labelledby="original" data-ein>
          <p class="ueberzeile">{original.buch_kurz} · {original.jahr}</p>
          <h2 id="original">{texte.original.titel}</h2>
          <figure class="r-auszug">
            <figcaption>{texte.original.auszugAlt}</figcaption>
            <blockquote lang={original.sprache_kennung} cite={original.digitalisat ?? original.abschrift}><p>{original.auszug_alt}</p></blockquote>
          </figure>
          <figure class="r-auszug heute">
            <figcaption>{texte.original.auszugHeute(original.sprache_original)}</figcaption>
            <blockquote><p>{original.auszug_heute}</p></blockquote>
          </figure>
          <p class="klein">{texte.original.quelle}: <cite lang={original.sprache_kennung}>{original.buch}</cite>, {original.verfasser}, {original.ort} {original.jahr}. {original.auszug_anmerkung}</p>
          <p class="klein">{texte.original.fassung}</p>
          <p class="r-original-links">
            <a href={original.digitalisat ?? original.abschrift} rel="noopener">{original.digitalisat ? texte.original.digitalisat : texte.original.abschrift}<span class="vh">: {original.buch}</span></a>
            {heutige && <a href={rezeptAdresse(heutige)}>{texte.original.heute}: {heutige.kurztitel}</a>}
            <a href={texte.original.rubrikZiel}>{texte.original.rubrikLink}</a>
          </p>
        </section>
      )}
      <section class="r-passt" aria-labelledby="passt">
        <h2 id="passt">{texte.passt.titel} <span class="r-zusatz">{texte.passt.zusatz}</span></h2>
        {formen.some(({ stand }) => stand) || ohne.length ? (
          <ul class="r-marken">
            {formen.filter(({ stand }) => stand === 'voll').map(({ schluessel, form }) => {
              const thema = themaZu('passt', schluessel);
              const wort = texte.passt[form];
              return <li class="voll"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...linien}><path d="M20 6L9 17l-5-5" /></svg>{thema && ziel(thema.adresse) ? <a href={thema.adresse} aria-label={thema.titel}>{wort}</a> : wort}</li>;
            })}
            {moeglich.map(({ form }) => <li class="umriss">{texte.passt.moeglich[form]}</li>)}
            {ohne.map((eintrag) => {
              const thema = themaZu('ohne', eintrag.schluessel);
              const wort = texte.passt.ohne(eintrag.ohne === eintrag.name ? eintrag.name : `${eintrag.ohne} (${eintrag.name})`);
              return <li><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...linien}><path d="M20 6L9 17l-5-5" /></svg>{thema && ziel(thema.adresse) ? <a href={thema.adresse} aria-label={thema.titel}>{wort}</a> : wort}</li>;
            })}
          </ul>
        ) : <p>{texte.passt.keine}</p>}
        {moeglich.map(({ form, zutaten }) => <p class="klein">{texte.passt.moeglichText(form, zutaten.join(', '))}</p>)}
        <p class="klein">{texte.passt.erklaerung}</p>
      </section>

      <section class="r-teil r-zutaten-karte" aria-labelledby="zutaten">
        <div class="r-kopfzeile">
          <h2 id="zutaten">{texte.zutaten.titel}</h2>
          {menge && <p class="r-fuer">{texte.zutaten.fuer} {menge}</p>}
        </div>
        {gruppen.map((gruppe) => (
          <>
            {gruppe.name && <h3>{gruppe.name}</h3>}
            <ul class="r-zutaten">
              {gruppe.zutaten.map((zutat) => (
                <li>
                  <span class="r-zutat">{zutat.menge && <b>{[zutat.menge, zutat.einheit].filter(Boolean).join(' ')}</b>} {zutat.name}</span>
                  {zutat.hinweise.length > 0 && (
                    <details class="r-hinweis">
                      <summary>{texte.zutaten.hinweise(zutat.hinweise.length)}</summary>
                      {jeZutat(zutat).map((zeile) => <p><b>{zeile.wort}:</b> {zeile.namen.join(', ')}</p>)}
                    </details>
                  )}
                </li>
              ))}
            </ul>
          </>
        ))}
      </section>

      <section class="r-teil" aria-labelledby="zubereitung">
        <h2 id="zubereitung">{texte.schritte.titel}</h2>
        <ol class="r-schritte">
          {rezept.schritte.map((schritt, nummer) => (
            <li id={`schritt-${nummer + 1}`} data-ein>
              <span class="r-nr" aria-hidden="true">{nummer + 1}</span>
              <div>
                <span class="r-marke">{texte.schritte.marke(nummer + 1)}</span>
                <p>{schritt}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="r-teil r-hinweise" aria-labelledby="hinweise">
        <h2 id="hinweise">{texte.hinweise.titel}</h2>
        {hinweise.length ? (
          <>
            <p class="r-einleitung">{texte.hinweise.einleitung}</p>
            <details class="r-umschalter">
              <summary>{texte.hinweise.tabelle}</summary>
              <div class="r-tabelle">
                <table>
                  <thead><tr>{texte.hinweise.spalten.map((kopf) => <th scope="col">{kopf}</th>)}</tr></thead>
                  <tbody>
                    {hinweise.map(({ eintrag, stufen }) => stufen.map((zeile, nummer) => (
                      <tr>
                        {nummer === 0 && <th scope="row" rowspan={stufen.length}>{eintrag.name}</th>}
                        <td>{zeile.text}</td>
                        <td>{zeile.zutaten.join(', ')}</td>
                      </tr>
                    )))}
                  </tbody>
                </table>
              </div>
            </details>
            <div class="r-stufenkarten">
              {jeStufe.map((gruppe) => (
                <div class="r-stufe" data-ein>
                  <h3><i class={gruppe.art} aria-hidden="true"></i>{gruppe.wort}</h3>
                  <p class="r-stufe-text">{gruppe.erklaerung}</p>
                  {gruppe.zeilen.length ? (
                    <dl>
                      {gruppe.zeilen.map((zeile) => <div><dt>{zeile.name}</dt><dd>{zeile.zutaten}</dd></div>)}
                    </dl>
                  ) : <p class="r-stufe-leer">{texte.hinweise.keine}</p>}
                </div>
              ))}
            </div>
          </>
        ) : <p>{texte.hinweise.keine}</p>}
        <p class="klein">{!spaeter && `${texte.hinweise.app} `}{fuss.hinweis}</p>
      </section>

      <section class="r-teil" aria-labelledby="naehrwerte">
        {rezept.nwVollstaendig ? (
          <>
            <h2 id="naehrwerte">{proPortion ? (stueck ? texte.naehrwerte.proStueck : texte.naehrwerte.proPortion) : texte.naehrwerte.je100}</h2>
            <div class="r-nw-raster">
              <div class="r-kcal muster" data-ein>
                <dl>
                  {NAEHRWERT.slice(0, 1).map(([feld, name, einheit, stellen]) => (
                    <div>
                      <dt>{name}</dt>
                      <dd>
                        {zahl((proPortion ? rezept.portion : rezept.je100)[feld], stellen)} {einheit}
                        {proPortion && <small>{zahl(rezept.je100[feld], stellen)} {einheit} {texte.naehrwerte.spalteJe100}</small>}
                      </dd>
                    </div>
                  ))}
                </dl>
                {stufe > 0 && (
                  <div class="r-energie">
                    <h3>{texte.naehrwerte.energie}: {texte.naehrwerte.energieStufe(ENERGIE.wort[rezept.energiedichte], stufe)}</h3>
                    <ol class="r-skala">
                      {ENERGIE.stufen.map((name, nummer) => (
                        <li class:list={{ voll: nummer < stufe, aktuell: name === rezept.energiedichte }} aria-current={name === rezept.energiedichte ? 'true' : undefined}>
                          <b>{ENERGIE.wort[name]}</b>{ENERGIE.bereich[name]}
                        </li>
                      ))}
                    </ol>
                    <p class="klein">{texte.naehrwerte.energieText}</p>
                    <p class="klein">{texte.naehrwerte.energieHinweis}</p>
                  </div>
                )}
              </div>
              <dl class="r-nw">
                {NAEHRWERT.slice(1).map(([feld, name, einheit, stellen]) => (
                  <div data-ein>
                    <dt>{name}</dt>
                    <dd>
                      {zahl((proPortion ? rezept.portion : rezept.je100)[feld], stellen)} {einheit}
                      {proPortion && <small>{zahl(rezept.je100[feld], stellen)} {einheit} {texte.naehrwerte.spalteJe100}</small>}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
            <details class="s-klapp">
              <summary>{texte.naehrwerte.tabelle}</summary>
              <div class="r-tabelle">
                <table class="r-zahlen">
                  {proPortion && <thead><tr><td></td><th scope="col">{spalte}</th><th scope="col">{texte.naehrwerte.spalteJe100}</th></tr></thead>}
                  <tbody>
                    {NAEHRWERT.map(([feld, name, einheit, stellen]) => (
                      <tr>
                        <th scope="row">{name}</th>
                        {proPortion && <td>{zahl(rezept.portion[feld], stellen)} {einheit}</td>}
                        <td>{zahl(rezept.je100[feld], stellen)} {einheit}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
            <p class="klein">{rezept.ohneSalzNachGeschmack && `${texte.naehrwerte.ohneSalz} `}{texte.naehrwerte.grundlage}</p>
          </>
        ) : (
          <>
            <h2 id="naehrwerte">{texte.naehrwerte.unvollstaendig[0]}</h2>
            <p>{texte.naehrwerte.unvollstaendig[1]}</p>
          </>
        )}
      </section>

      <section class="r-teil r-app muster" aria-labelledby="app" data-ein>
        <Motive liste={[{ art: 'zitrone', breite: 160, lage: 'right: -36px; bottom: -44px' }]} />
        <div class="r-app-text">
          <h2 id="app">{spaeter ? texte.spaeter.titel : texte.app.titel}</h2>
          {spaeter
            ? <p>{texte.spaeter.appText}</p>
            : <p>{texte.app.text.split(texte.app.link.text)[0]}<a href={texte.app.link.ziel}>{texte.app.link.text}</a>{texte.app.text.split(texte.app.link.text)[1]} {texte.app.mehr}</p>}
        </div>
        <p class="r-app-zeile">
          <a class="knopf voll" href="/so-gehts/">{texte.app.soGehts}</a>
          {store.oeffentlich ? <a class="knopf rand" href={store.adresse} rel="noopener">{fuss.auftritte.storeLink}</a> : <span class="r-bald">{fuss.auftritte.storeBald}</span>}
        </p>
      </section>

      <p class="r-quelle-link"><a href={quelleAdresse(rezept)} aria-label={texte.quelle.fuer(rezept.kurztitel)}>{texte.quelle.link}</a></p>
      {alteFassungen.map((anderes) => (
        <p class="r-quelle-link r-alt-link"><a href={rezeptAdresse(anderes)}>{texte.original.alt(anderes.original.jahr)}: {anderes.kurztitel}</a></p>
      ))}

      <section class="r-teil" aria-labelledby="aehnlich">
        <h2 id="aehnlich">{texte.aehnlich}</h2>
        <ul class="r-karten gefasst">{nah.map((anderes) => <Rezeptkarte rezept={anderes} />)}</ul>
        {themenLinks.length > 0 && (
          <div class="r-mehr">
            <h3>{texte.themenTitel}</h3>
            <ul class="chips">{themenLinks.map((thema) => <li><a class="chip" href={thema.adresse}>{thema.titel}</a></li>)}</ul>
          </div>
        )}
      </section>
    </div>
  </article>
</Basis>

<script>
  // Sprungleiste: Der Abschnitt, der gerade gelesen wird, ist hervorgehoben. Ohne Skript sind alle Einträge gleich.
  const leiste = document.querySelector('[data-sprung]');
  if (leiste && 'IntersectionObserver' in window) {
    const links = new Map([...leiste.querySelectorAll('a')].map((link) => [link.getAttribute('href').slice(1), link]));
    const teile = [...links.keys()].map((anker) => document.getElementById(anker)?.closest('section')).filter(Boolean);
    const zeige = (aktuell) => {
      for (const [anker, link] of links) {
        if (anker === aktuell) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };
    // Gelesen wird der letzte Abschnitt, dessen Anfang über der Mitte des Fensters liegt.
    const lies = () => {
      let aktuell;
      for (const teil of teile) {
        if (teil.getBoundingClientRect().top > window.innerHeight * 0.5) break;
        aktuell = teil.querySelector('h2[id]')?.id;
      }
      zeige(aktuell);
    };
    let geplant = false;
    window.addEventListener('scroll', () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(() => { geplant = false; lies(); });
    }, { passive: true });
    lies();
  }
</script>

<script>
  // Knopf "Rezept teilen" (AP-18 Nacharbeiten Teil J). Am Handy öffnet er das Teilen-Menü des Geräts (Web Share API)
  // mit Titel, einem Satz und der kanonischen Adresse der Seite. Wo das Gerät das nicht kann, kopiert er die Adresse
  // und zeigt kurz "Link kopiert". Die Website überträgt dabei nichts und legt nichts im Speicher des Browsers ab.
  // Ohne JavaScript ist der Knopf nicht zu sehen (rezepte.css); kann der Browser weder teilen noch kopieren, auch nicht.
  const knopf = document.querySelector('[data-teilen]');
  if (knopf) {
    const status = document.querySelector('[data-teilen-status]');
    const { titel, text, adresse, kopiert, fehler } = knopf.dataset;
    const daten = { title: titel, text, url: adresse };
    const kannTeilen = typeof navigator.share === 'function' && (typeof navigator.canShare !== 'function' || navigator.canShare(daten));
    const kannKopieren = typeof navigator.clipboard?.writeText === 'function';
    if (!kannTeilen && !kannKopieren) knopf.parentElement.hidden = true;

    let uhr;
    const melde = (wort) => {
      status.textContent = wort;
      clearTimeout(uhr);
      uhr = setTimeout(() => { status.textContent = ''; }, 4000);
    };
    const kopiere = async () => {
      try {
        await navigator.clipboard.writeText(adresse);
        melde(kopiert);
      } catch {
        melde(fehler);
      }
    };
    knopf.addEventListener('click', async () => {
      if (kannTeilen) {
        try {
          await navigator.share(daten);
          return;
        } catch (grund) {
          // Wer das Teilen-Menü schließt, ohne zu teilen, bekommt keine Meldung.
          if (grund?.name === 'AbortError') return;
        }
      }
      if (kannKopieren) await kopiere();
      else melde(fehler);
    });
  }
</script>
